---
const currentPath = Astro.url?.pathname || '/';

const navLinks = [
  { href: '/blog',   label: 'Blog' },
  { href: '/photo',  label: 'Photo' },
  { href: '/aigc',   label: 'AIGC' },
  { href: '/link',   label: 'Link' },
  { href: '/about',  label: 'About' },
];
---
<!-- Logo 视觉层 — 独立于导航栏 -->
<a class="nav-logo-overlay" id="nav-logo-overlay" href="/">
  <img src="/img/laa/char1.webp" alt="Logo" id="nav-logo-img">
</a>

<!-- 导航栏 -->
<nav class="smart-navbar" id="main-nav">
  <div class="nav-logo-placeholder"></div>
  <div class="nav-links-wrapper">
    <div class="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
  <div class="nav-actions">
    <div class="music-bars" id="music-bars">
      <span class="music-bar"></span>
      <span class="music-bar"></span>
      <span class="music-bar"></span>
      <span class="music-bar"></span>
    </div>
    <button class="theme-toggle" id="nav-theme-toggle" aria-label="切换主题">
      <span class="toggle-track">
        <span class="toggle-knob">
          <svg class="toggle-icon toggle-sun" viewBox="0 0 24 24" width="14" height="14">
            <path fill="currentColor" d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0 1.41.996.996 0 0 0 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06z"/>
          </svg>
          <svg class="toggle-icon toggle-moon" viewBox="0 0 24 24" width="14" height="14">
            <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
        </span>
      </span>
    </button>
    <button class="button meteor-btn" id="mybutton" aria-label="Toggle Menu" aria-expanded="false">
      <div class="btn">
        <span class="meteor-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 3L3 10.5L9.5 12.5L12.5 19L21 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M10 13.5L13 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="meteor-trail"></div>
      </div>
    </button>
  </div>
</nav>

<!-- 侧边栏遮罩 -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<!-- 侧边栏 -->
<nav class="sidebar" id="sidebar" aria-hidden="true">
  <div class="sidebar-glass"></div>
  <div class="sidebar-nav">
    {navLinks.map((link, i) => (
      <button
        class={`sidebar-link ${currentPath.startsWith(link.href) ? 'active' : ''}`}
        data-href={link.href}
        style={`transition-delay: ${i * 0.06}s`}
      >
        {link.label}
      </button>
    ))}
  </div>
  <div class="sidebar-bottom">
    <button class="theme-toggle sidebar-toggle" id="sidebar-theme-toggle" aria-label="切换主题">
      <span class="toggle-track">
        <span class="toggle-knob">
          <svg class="toggle-icon toggle-sun" viewBox="0 0 24 24" width="16" height="16">
            <path fill="currentColor" d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0 1.41.996.996 0 0 0 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06z"/>
          </svg>
          <svg class="toggle-icon toggle-moon" viewBox="0 0 24 24" width="16" height="16">
            <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
        </span>
      </span>
    </button>
  </div>
</nav>

<script>
  const htmlEl = document.documentElement;

  // ===================== Logo 移到 body 下，脱离 #app =====================
  const logoEl = document.getElementById('nav-logo-overlay');
  if (logoEl) {
    document.body.appendChild(logoEl);
    if (!document.body.classList.contains('index-page')) {
      logoEl.classList.add('logo-visible');
    }
  }

  // ===================== 主题切换 =====================
  function toggleTheme() {
    const next = htmlEl.dataset.theme === 'light' ? 'dark' : 'light';
    htmlEl.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncThemeIcons(next);
    window.dispatchEvent(new Event('theme-change'));
  }

  function syncThemeIcons(theme: string) {
    document.querySelectorAll('.theme-toggle').forEach(btn => {
      btn.classList.toggle('is-dark', theme === 'dark');
    });
  }

  syncThemeIcons(htmlEl.dataset.theme || 'light');
  document.getElementById('nav-theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('sidebar-theme-toggle')?.addEventListener('click', toggleTheme);
  window.addEventListener('theme-change', () => syncThemeIcons(htmlEl.dataset.theme || 'light'));

  // ===================== 侧边栏 =====================
  const sidebar = document.getElementById('sidebar');
  const navBtn = document.getElementById('mybutton');
  const overlay = document.getElementById('sidebar-overlay');

  function openSidebar() {
    sidebar?.classList.add('active');
    sidebar?.setAttribute('aria-hidden', 'false');
    overlay?.classList.add('active');
    navBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar?.classList.remove('active');
    sidebar?.setAttribute('aria-hidden', 'true');
    overlay?.classList.remove('active');
    navBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  navBtn?.addEventListener('click', (e) => { e.stopPropagation(); openSidebar(); });
  navBtn?.addEventListener('touchend', (e) => { e.preventDefault(); openSidebar(); });

  overlay?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('touchend', (e) => { e.preventDefault(); closeSidebar(); });

  document.querySelectorAll('.sidebar-link').forEach(btn => {
    btn.addEventListener('click', () => {
      const href = (btn as HTMLElement).dataset.href;
      if (href) { closeSidebar(); setTimeout(() => { window.location.href = href; }, 150); }
    });
  });

  // ===================== 导航栏滚动隐藏 =====================
  let lastY = window.scrollY;
  const navbar = document.getElementById('main-nav');
  const logoOverlay = document.getElementById('nav-logo-overlay');
  let navTick = false;

  function updateNav() {
    const y = window.scrollY;
    const show = y < lastY || y <= 100;
    navbar?.classList.toggle('nav-hidden', !show);
    logoOverlay?.classList.toggle('nav-hidden', !show);
    lastY = y;
    navTick = false;
  }

  window.addEventListener('scroll', () => {
    if (!navTick) { requestAnimationFrame(updateNav); navTick = true; }
  }, { passive: true });

</script>
