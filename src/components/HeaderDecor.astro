---
// 头部装饰区 — 大字 + 满屏错位"blue" + 黑球透视窗口 + 波浪
---

<header class="theme-header-decor" id="header-decor">
  <!-- 满屏错位小字 "blue" -->
  <div class="text-wall">
    {Array.from({ length: 12 }, (_, row) => (
      <div class={`wall-row ${row % 2 === 1 ? 'wall-row-offset' : ''}`}>
        {Array.from({ length: 25 }, () => (
          <span class="wall-word">blue</span>
        ))}
      </div>
    ))}
  </div>

  <!-- 中间大字 -->
  <div class="hero-text" id="hero-text">hello, I'm Blue</div>

  <!-- 黑球（放在 header 内部，absolute 定位） -->
  <div class="cursor-ball" id="cursor-ball">
    <div class="ball-hero" id="ball-hero">你好，我是蓝色</div>
    <div class="ball-wall" id="ball-wall">
      {Array.from({ length: 12 }, (_, row) => (
        <div class={`wall-row ${row % 2 === 1 ? 'wall-row-offset' : ''}`}>
          {Array.from({ length: 25 }, () => (
            <span class="wall-word">blue</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- 波浪 -->
  <svg class="header-wave" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
       viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
    <defs>
      <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
    </defs>
    <g class="parallax">
      <use xlink:href="#gentle-wave" x="48" y="0" />
      <use xlink:href="#gentle-wave" x="48" y="3" />
      <use xlink:href="#gentle-wave" x="48" y="5" />
      <use xlink:href="#gentle-wave" x="48" y="7" />
    </g>
  </svg>
  <div class="header-wave-fill"></div>
</header>

<script>
  (function() {
    const header = document.getElementById('header-decor')!;
    const ball = document.getElementById('cursor-ball')!;
    const ballHero = document.getElementById('ball-hero')!;
    const ballWall = document.getElementById('ball-wall')!;
    const heroText = document.getElementById('hero-text')!;

    let mouseX = -500, mouseY = -500;
    let ballX = -500, ballY = -500;
    let overHeader = false;
    let exiting = false;
    let visible = false;

    const velHistory: {x: number, y: number}[] = [];
    const VEL_FRAMES = 5;
    let prevMX = 0, prevMY = 0;

    function addVel(vx: number, vy: number) {
      velHistory.push({ x: vx, y: vy });
      if (velHistory.length > VEL_FRAMES) velHistory.shift();
    }

    function getAvgVel() {
      if (velHistory.length === 0) return { x: 0, y: 8 };
      let sx = 0, sy = 0;
      for (const v of velHistory) { sx += v.x; sy += v.y; }
      return { x: sx / velHistory.length, y: sy / velHistory.length };
    }

    header.addEventListener('mouseenter', function(e: any) {
      overHeader = true;
      exiting = false;
      visible = true;
      velHistory.length = 0;
      ball.style.display = 'block';
      const rect = header.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      prevMX = mouseX;
      prevMY = mouseY;
    });

    header.addEventListener('mousemove', function(e: any) {
      if (!overHeader) return;
      const rect = header.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      addVel(mx - prevMX, my - prevMY);
      prevMX = mx;
      prevMY = my;
      mouseX = mx;
      mouseY = my;
    });

    header.addEventListener('mouseleave', function(e: any) {
      overHeader = false;
      exiting = true;
      const rect = header.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      addVel(mx - prevMX, my - prevMY);
      mouseX = mx;
      mouseY = my;
    });

    // 滚动时如果 header 不可见，隐藏球
    function checkVisibility() {
      if (!visible) return;
      const rect = header.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) {
        ball.style.display = 'none';
        visible = false;
        exiting = false;
      }
    }

    function animate() {
      checkVisibility();

      if (exiting) {
        const vel = getAvgVel();
        mouseX += vel.x * 4;
        mouseY += vel.y * 4;
      }

      ballX += (mouseX - ballX) * 0.18;
      ballY += (mouseY - ballY) * 0.18;

      ball.style.left = ballX + 'px';
      ball.style.top = ballY + 'px';

      // 中文大字对齐英文大字
      if (visible) {
        const tr = heroText.getBoundingClientRect();
        const hr = header.getBoundingClientRect();
        const heroCX = tr.left + tr.width / 2 - hr.left;
        const heroCY = tr.top + tr.height / 2 - hr.top;
        const dx = heroCX - ballX;
        const dy = heroCY - ballY;
        ballHero.style.transform = 'translate(calc(-50% + ' + dx + 'px), calc(-50% + ' + dy + 'px))';
        ballWall.style.transform = 'translate(calc(-50% + ' + dx + 'px), calc(-50% + ' + dy + 'px))';
      }

      // 球移出 header 区域后隐藏
      if (exiting) {
        const hRect = header.getBoundingClientRect();
        if (ballX < -300 || ballX > hRect.width + 300 || ballY < -300 || ballY > hRect.height + 300) {
          ball.style.display = 'none';
          visible = false;
          exiting = false;
          velHistory.length = 0;
        }
      }

      requestAnimationFrame(animate);
    }
    animate();
  })();
</script>

<style>
  .theme-header-decor {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 500px;
    overflow: hidden;
    background: var(--bg);
    cursor: crosshair;
  }

  /* 满屏错位小字墙 */
  .text-wall {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    overflow: hidden;
    z-index: 1;
  }

  .wall-row {
    display: flex;
    gap: 32px;
    white-space: nowrap;
  }

  .wall-row-offset {
    margin-left: 80px;
  }

  .wall-word {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    color: var(--text);
    opacity: 0.06;
    user-select: none;
    letter-spacing: 8px;
    text-transform: lowercase;
  }

  :global([data-theme="dark"]) .wall-word {
    opacity: 0.04;
  }

  /* 中间大字 */
  .hero-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(52px, 11vw, 130px);
    font-weight: 900;
    color: var(--text);
    opacity: 0.9;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    z-index: 2;
    letter-spacing: -3px;
  }

  /* 球体 */
  .cursor-ball {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: #000;
    transform: translate(-50%, -50%);
    display: none;
    pointer-events: none;
    z-index: 3;
    will-change: left, top;
    overflow: hidden;
    box-shadow: 0 0 100px rgba(0, 0, 0, 0.5);
  }

  :global([data-theme="dark"]) .cursor-ball {
    background: #fff;
    box-shadow: 0 0 100px rgba(255, 255, 255, 0.3);
  }

  /* 球内中文大字 */
  .ball-hero {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: clamp(52px, 11vw, 130px);
    font-weight: 900;
    color: #fff;
    white-space: nowrap;
    letter-spacing: -3px;
    will-change: transform;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .ball-hero {
    color: #000;
  }

  /* 球内中文小字墙 */
  .ball-wall {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    width: max-content;
    will-change: transform;
    pointer-events: none;
  }

  .ball-wall .wall-word {
    color: #fff;
    opacity: 0.15;
    font-size: clamp(36px, 5vw, 60px);
  }

  :global([data-theme="dark"]) .ball-wall .wall-word {
    color: #000;
    opacity: 0.1;
  }

  /* 波浪 */
  .header-wave {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 100%;
    height: 100px;
    margin-bottom: -1px;
    z-index: 4;
  }

  .header-wave-fill {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 10;
    background: var(--bg);
  }

  /* 波浪动画 */
  .parallax > use {
    animation: move-forever 25s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }
  .parallax > use:nth-child(1) { animation-delay: -2s; animation-duration: 7s;  fill: var(--wave-1); opacity: 0.7; }
  .parallax > use:nth-child(2) { animation-delay: -3s; animation-duration: 10s; fill: var(--wave-2); opacity: 0.5; }
  .parallax > use:nth-child(3) { animation-delay: -4s; animation-duration: 13s; fill: var(--wave-3); opacity: 0.3; }
  .parallax > use:nth-child(4) { animation-delay: -5s; animation-duration: 20s; fill: var(--bg);    opacity: 1; }

  /* 移动端 */
  @media (max-width: 768px) {
    .cursor-ball { display: none !important; }
    .theme-header-decor { cursor: auto; }
  }
</style>
