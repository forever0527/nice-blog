---
// 星空背景 + 流星特效（仅深色模式）
---
<canvas id="star-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;"></canvas>

<script>
  const canvas = document.getElementById('star-canvas') as HTMLCanvasElement;
  if (!canvas) { throw new Error('star-canvas not found'); }
  const ctx = canvas.getContext('2d')!;

  let W = 0, H = 0;
  let stars: { x: number; y: number; r: number; a: number; da: number; vx: number; vy: number; blue: boolean }[] = [];
  let meteors: { x: number; y: number; len: number; speed: number; angle: number; life: number; size: number }[] = [];
  let raf = 0;
  let active = false;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }

  function createStars(count: number) {
    stars = [];
    for (let i = 0; i < count; i++) {
      const isBlue = Math.random() < 0.3;
      stars.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: isBlue ? Math.random() * 1.8 + 0.5 : Math.random() * 1.2 + 0.3,
        a: Math.random(),
        da: (Math.random() - 0.5) * 0.01 + (Math.random() - 0.5) * 0.008,
        vx: (Math.random() - 0.5) * 0.08,
        vy: Math.random() * 0.04 + 0.01,
        blue: isBlue,
      });
    }
  }

  function spawnMeteor() {
    if (Math.random() > 0.025) return;
    const angle = -Math.PI / 4 - Math.random() * 0.4;
    meteors.push({
      x: Math.random() * W * 0.6 + W * 0.2,
      y: H + 20,
      len: Math.random() * 100 + 80,
      speed: Math.random() * 10 + 8,
      angle,
      life: 1,
      size: Math.random() * 1.5 + 0.8,
    });
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    for (const s of stars) {
      s.x += s.vx;
      s.y += s.vy;
      if (s.x < 0) s.x = W;
      if (s.x > W) s.x = 0;
      if (s.y > H) { s.y = 0; s.x = Math.random() * W; }

      s.a += s.da;
      if (s.a > 1 || s.a < 0.1) s.da = -s.da;

      const alpha = s.a * 0.8;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = s.blue
        ? `rgba(120,160,255,${alpha})`
        : `rgba(255,255,255,${alpha})`;
      ctx.fill();

      if (s.blue && s.a > 0.5) {
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r * 2.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(100,140,255,${alpha * 0.15})`;
        ctx.fill();
      }
    }

    for (let i = meteors.length - 1; i >= 0; i--) {
      const m = meteors[i];
      m.x += Math.cos(m.angle) * m.speed;
      m.y += Math.sin(m.angle) * m.speed;
      m.life -= 0.015;

      if (m.life <= 0 || m.x > W + 100 || m.y > H + 100) {
        meteors.splice(i, 1);
        continue;
      }

      const tailX = m.x - Math.cos(m.angle) * m.len;
      const tailY = m.y - Math.sin(m.angle) * m.len;

      const grad = ctx.createLinearGradient(tailX, tailY, m.x, m.y);
      grad.addColorStop(0, `rgba(255,255,255,0)`);
      grad.addColorStop(1, `rgba(255,255,255,${m.life * 0.9})`);

      ctx.beginPath();
      ctx.moveTo(tailX, tailY);
      ctx.lineTo(m.x, m.y);
      ctx.strokeStyle = grad;
      ctx.lineWidth = m.size;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(m.x, m.y, m.size * 0.8, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${m.life})`;
      ctx.fill();
    }

    spawnMeteor();
    if (active) raf = requestAnimationFrame(draw);
  }

  function start() {
    if (active) return;
    active = true;
    resize();
    createStars(Math.min(Math.floor(W * H / 1500), 250));
    draw();
  }

  function stop() {
    active = false;
    cancelAnimationFrame(raf);
    ctx.clearRect(0, 0, W, H);
    stars = [];
    meteors = [];
  }

  function checkTheme() {
    if (document.documentElement.dataset.theme === 'dark') {
      start();
    } else {
      stop();
    }
  }

  window.addEventListener('resize', () => {
    if (active) { resize(); createStars(Math.min(Math.floor(W * H / 1500), 250)); }
  });
  window.addEventListener('theme-change', checkTheme);
  checkTheme();
</script>
