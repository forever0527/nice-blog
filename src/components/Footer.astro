---
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
---

<footer class="smart-footer">
  <div class="footer-inner">
    <div class="footer-info">
      <h3>About This Site</h3>
      <span class="footer-shop"><Icon name="shopping-cart" size={14} /> 商店: <a href="https://h5.lot-ml.com/ProductEn/Index/e00550774205a3f5" style="color: var(--text);">我不是卡神</a> <span style="margin:0 5px">|</span> <a href="https://h5.gantanhao.com/?timestamp=1743511677638&from=3%40C%40%40FptD%3FCD%3F%3BGppD%3BBoBA%3BpDGA%3BBrsFtFsrGt%3Es3%40C%40%40" style="color: var(--text);">卡布奇诺</a></span>
      <p>致力于提供极致的交互体验。本站基于 Astro 构建。</p>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-runtime">
      <span>已稳定运行</span>
      <div id="site-runtime" class="time-display">加载中...</div>
    </div>
    <div class="footer-copyright">
      <div class="tail">
        <a href="/">
          <img src="/img/laa/char.webp" alt="尾句" style="height:auto; width:300px; filter: invert(var(--invert-rate, 1));">
        </a>
      </div>
      &copy; 2025 - {currentYear} True Blue. All Rights Reserved. beat:2.0.1
    </div>
  </div>
</footer>

<script>
  const startTime = new Date('2025-10-31T12:00:00').getTime();
  const el = document.getElementById('site-runtime');

  function updateRuntime() {
    if (!el) return;
    const diff = Date.now() - startTime;
    const d = Math.floor(diff / 864e5);
    const h = Math.floor((diff % 864e5) / 36e5);
    const m = Math.floor((diff % 36e5) / 6e4);
    const s = Math.floor((diff % 6e4) / 1e3);
    el.textContent = `${d}天 ${h}小时 ${m}分 ${s}秒`;
  }

  updateRuntime();
  setInterval(updateRuntime, 1000);
</script>