---
import Icon from './Icon.astro';
import siteData from '../content/site.json';
const currentYear = new Date().getFullYear();
const footer = siteData.footer;
const shopLinks = siteData.shopLinks;
---

<footer class="smart-footer">
  <div class="footer-inner">
    <div class="footer-info">
      <h3>{footer.heading}</h3>
      <span class="footer-shop"><Icon name="shopping-cart" size={14} /> 商店: {shopLinks.map((shop, i) => (<Fragment>{i > 0 && <span style="margin:0 5px">|</span>}<a href={shop.url} style="color: var(--text);">{shop.label}</a></Fragment>))}</span>
      <p>{footer.description}</p>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-runtime">
      <span>已稳定运行</span>
      <div id="site-runtime" class="time-display">加载中...</div>
    </div>
    <div class="footer-copyright">
      <div class="tail">
        <a href="/character" target="_blank" rel="noopener">
          <img src="/img/laa/char.webp" alt="尾句" style="height:auto; width:300px; filter: invert(var(--invert-rate, 1));">
        </a>
      </div>
      &copy; 2025 - {currentYear} {siteData.name}. All Rights Reserved. beat:{footer.version}
    </div>
  </div>
</footer>

<script define:vars={{ startDate: footer.startDate }}>
  const startTime = new Date(startDate).getTime();
  const el = document.getElementById('site-runtime');

  function updateRuntime() {
    if (!el) return;
    const diff = Date.now() - startTime;
    const d = Math.floor(diff / 864e5);
    const h = Math.floor((diff % 864e5) / 36e5);
    const m = Math.floor((diff % 36e5) / 6e4);
    const s = Math.floor((diff % 6e4) / 1e3);
    el.textContent = `${d}天 ${h}小时 ${m}分 ${s}秒`;
  }

  updateRuntime();
  setInterval(updateRuntime, 1000);
</script>