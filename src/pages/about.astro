---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import Icon from '../components/Icon.astro';
import HeroTitle from '../components/HeroTitle.astro';
import aboutData from '../content/about.json';

const stats = aboutData.stats;
const skills = aboutData.skills;
const timeline = aboutData.timeline;
const socials = aboutData.socials;
const profile = aboutData.profile;
const subtitle = aboutData.subtitle;
---

<BaseLayout title="About - 懒得取名">
  <Snow />
  <Header />

  <main class="page">
    <HeroTitle title="关于" subtitle={subtitle} />

    <!-- 个人卡片 -->
    <section class="profile-card reveal" style="--i:0">
      <div class="profile-top">

        <div class="profile-info">
          <h2 class="profile-name">{profile.name}</h2>
          <p class="profile-role">{profile.role}</p>
          <p class="profile-bio">
            {profile.bio}
          </p>
          <div class="profile-links">
            {socials.map(s => (
              <a href={s.url} target="_blank" rel="noopener" class="social-btn" aria-label={s.label}>
                <Icon name={s.icon} size={15} /> {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 数据 -->
      <div class="stats-row">
        {stats.map(s => (
          <div class="stat">
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 技能 -->
    <section class="skills-card reveal" style="--i:1">
      <h3 class="section-heading">技术栈</h3>
      <div class="skills-list">
        {skills.map(s => (
          <div class="skill-row">
            <span class="skill-name">{s.name}</span>
            <div class="skill-track">
              <div class="skill-fill" style={`--level: ${s.level}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 时间线 -->
    <section class="timeline-card reveal" style="--i:2">
      <h3 class="section-heading">旅程</h3>
      <div class="timeline">
        {timeline.map((t, i) => (
          <div class="tl-item" style={`--i: ${i}`}>
            <div class="tl-dot"></div>
            {i < timeline.length - 1 && <div class="tl-line"></div>}
            <div class="tl-content">
              <span class="tl-year">{t.year}</span>
              <h4 class="tl-title">{t.title}</h4>
              <p class="tl-desc">{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
  <FloatingButtons />
</BaseLayout>

<style>
  .page {
    width: 100%;
    min-height: calc(100vh - 76px);
    background: transparent;
    padding: 40px clamp(20px, 4vw, 48px) 120px;
    max-width: 780px;
    margin: 0 auto;
  }

  /* ── Profile Card ── */
  .profile-card {
    border-radius: 22px;
    background: transparent;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(120,120,120,0.5);
    padding: clamp(24px, 4vw, 36px);
    margin-bottom: 24px;
    transition: border-color 0.3s, transform 0.3s ease;
    box-shadow: 3px 3px 10px var(--nav-edge), 1px 1px 3px var(--nav-edge);
  }
  .profile-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0,64,255,0.25);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04), 0 0 0 1px rgba(0,64,255,0.06);
  }
  :global([data-theme="dark"]) .profile-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.2), 0 0 0 1px rgba(0,64,255,0.12);
  }
  :global([data-theme="dark"]) .profile-card {
    background: transparent;
    border-color: rgba(80,90,110,0.4);
  }
  .profile-top {
    display: flex;
    gap: 24px;
    margin-bottom: 28px;
  }
  .profile-info { flex: 1; min-width: 0; }
  .profile-name { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .profile-role { font-size: 0.8rem; color: var(--text); opacity: 0.4; margin-bottom: 14px; letter-spacing: 0.5px; }
  .profile-bio { font-size: 0.88rem; color: var(--text); opacity: 0.5; line-height: 1.75; margin-bottom: 18px; }
  .profile-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 10px;
    background: rgba(128,128,128,0.05);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: background 0.25s, color 0.25s, transform 0.25s;
    cursor: pointer;
  }
  .social-btn:hover {
    background: rgba(0,64,255,0.1);
    color: #0040ff;
    transform: translateY(-1px);
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(128,128,128,0.06);
    border-radius: 14px;
    overflow: hidden;
  }
  .stat {
    background: transparent;
    text-align: center;
    padding: 22px 10px;
  }
  .stat-num {
    display: block;
    font-family: 'Georgia',serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text);
    opacity: 0.3;
  }

  /* ── Cards ── */
  .skills-card, .timeline-card {
    border-radius: 22px;
    background: transparent;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(120,120,120,0.5);
    padding: clamp(24px, 4vw, 36px);
    margin-bottom: 24px;
    transition: border-color 0.3s, transform 0.3s ease;
    box-shadow: 3px 3px 10px var(--nav-edge), 1px 1px 3px var(--nav-edge);
  }
  .skills-card:hover, .timeline-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0,64,255,0.25);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04), 0 0 0 1px rgba(0,64,255,0.06);
  }
  :global([data-theme="dark"]) .skills-card:hover,
  :global([data-theme="dark"]) .timeline-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.2), 0 0 0 1px rgba(0,64,255,0.12);
  }
  :global([data-theme="dark"]) .skills-card,
  :global([data-theme="dark"]) .timeline-card {
    background: transparent;
    border-color: rgba(80,90,110,0.4);
  }
  .section-heading {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--text);
    opacity: 0.28;
    margin-bottom: 24px;
    font-weight: 600;
  }

  /* Skills */
  .skills-list { display: flex; flex-direction: column; gap: 16px; }
  .skill-row { display: flex; align-items: center; gap: 14px; }
  .skill-name {
    width: 130px;
    font-size: 0.82rem;
    color: var(--text);
    opacity: 0.5;
    flex-shrink: 0;
    letter-spacing: 0.3px;
  }
  .skill-track {
    flex: 1;
    height: 5px;
    border-radius: 3px;
    background: rgba(128,128,128,0.08);
    overflow: hidden;
  }
  .skill-fill {
    height: 100%;
    border-radius: 3px;
    width: 0;
    background: linear-gradient(90deg, #0040ff, #00d2ff);
    transition: width 0.9s cubic-bezier(0.22,0.61,0.36,1);
  }
  .skill-fill.in-view { width: var(--level); }

  /* Timeline */
  .timeline { position: relative; padding-left: 24px; }
  .tl-item { position: relative; padding-bottom: 28px; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-dot {
    position: absolute;
    left: -28px;
    top: 3px;
    width: 8px; height: 8px;
    border-radius: 50%;
    border: 2px solid rgba(128,128,128,0.2);
    background: transparent;
    z-index: 1;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .tl-item:hover .tl-dot {
    border-color: #0040ff;
    box-shadow: 0 0 10px rgba(0,64,255,0.3);
    transform: scale(1.3);
  }
  .tl-line {
    position: absolute;
    left: -24.5px;
    top: 14px;
    width: 1px;
    height: calc(100% - 4px);
    background: rgba(128,128,128,0.08);
  }
  .tl-content { padding-left: 0; }
  .tl-year {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #0040ff;
    opacity: 0.55;
    margin-bottom: 4px;
  }
  .tl-title { font-size: 0.92rem; font-weight: 600; color: var(--text); margin-bottom: 2px; }
  .tl-desc { font-size: 0.8rem; color: var(--text); opacity: 0.4; line-height: 1.6; }

  @media (max-width: 768px) {
    .page { padding: 24px 16px 80px; }
    .profile-top { flex-direction: column; align-items: center; text-align: center; }
    .profile-links { justify-content: center; }
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .skill-name { width: 90px; font-size: 0.74rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-fill { transition: none; }
    .reveal { opacity:1; transform:none; transition:none; }
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(28px) scale(0.97);
    transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1) calc(var(--i,0) * 0.1s),
                transform 0.6s cubic-bezier(0.16,1,0.3,1) calc(var(--i,0) * 0.1s);
  }
  .reveal.visible { opacity:1; transform:translateY(0) scale(1); }
</style>

<script>
  document.querySelectorAll('.reveal').forEach(function(el){
    new IntersectionObserver(function(entries,obs){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
    },{threshold:0.08,rootMargin:'0px 0px -30px 0px'}).observe(el);
  });
</script>
