---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
const allTags = [...new Set(posts.map(p => p.data.tag))];
const ITEMS_PER_PAGE = 12;
const totalPages = Math.ceil(posts.length / ITEMS_PER_PAGE);
---

<BaseLayout title="Blog - 懒得取名">
  <Snow />
  <Header />

  <!-- Hero 视频背景 -->
  <div class="blog-hero-fixed">
    <video class="blog-hero-video" autoplay muted loop playsinline preload="metadata">
      <source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260314_131748_f2ca2a28-fed7-44c8-b9a9-bd9acdd5ec31.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
  </div>

  <!-- Hero 内容 -->
  <section class="blog-hero-section">
    <div class="hero-content">
      <p class="hero-tag anim-fade-up" style="animation-delay:0.2s">EST. 2025 — PERSONAL BLOG</p>
      <h1 class="hero-title">
        <span class="hero-line anim-fade-up" style="animation-delay:0.5s">Thoughts</span>
        <span class="hero-line hero-cursive anim-fade-up" style="animation-delay:0.8s">crafted</span>
        <span class="hero-line anim-fade-up" style="animation-delay:1.1s">with care</span>
      </h1>
      <div class="hero-divider anim-scale-x" style="animation-delay:1.4s"></div>
      <p class="hero-sub anim-fade-up" style="animation-delay:1.6s">记录学习、思考与创作的旅程</p>
    </div>
    <div class="hero-scroll-hint anim-fade-up" style="animation-delay:2s">
      <span>SCROLL</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <main class="blg" id="blog-content">
    <div class="blg-layout">
    <div class="blg-main">
    <!-- 功能栏 -->
    <div class="blg-bar">
      <div class="blg-tags" id="blg-tags">
        <button class="blg-chip on" data-tag="全部">全部</button>
        {allTags.slice(0, 4).map(tag => (
          <button class="blg-chip" data-tag={tag}>{tag}</button>
        ))}
        {allTags.length > 4 && <span class="blg-tags-more" id="blg-tags-more">+{allTags.length - 4}</span>}
      </div>
      <div class="blg-search-group">
        <div class="blg-search">
          <span class="blg-search-icon"><Icon name="search" size={13} /></span>
          <input type="text" class="blg-search-input" id="blg-search" placeholder="搜索文章..." />
        </div>
        <span class="blg-num" id="blg-num">{posts.length} 篇</span>
      </div>
    </div>

    <!-- 骨架屏 -->
    <div class="blg-skeleton" id="blg-skeleton">
      {Array.from({length:6}).map(() => (
        <div class="skeleton-card">
          <div class="skeleton-img"></div>
          <div class="skeleton-content">
            <div class="skeleton-tag"></div>
            <div class="skeleton-title"></div>
            <div class="skeleton-desc"></div>
            <div class="skeleton-desc"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- 双列卡片 -->
    <div class="blg-grid" id="blg-grid">
      {posts.map((post, index) => {
        const { title, desc, date, tag, color, img } = post.data;
        const page = Math.floor(index / ITEMS_PER_PAGE) + 1;
        return (
          <article class="blg-card" data-tag={tag} data-page={page}>
            <a href={'/blog/' + post.slug} class="blg-link">
              <div class="blg-img">
                <img src={img || '/img/bg/1.webp'} alt={title} loading="lazy" />
              </div>
              <div class="blg-overlay">
                <span class="blg-tag" style={`background:${color||'#0040ff'}`}>{tag}</span>
                <h2 class="blg-title">{title}</h2>
                <p class="blg-desc">{desc}</p>
                <time class="blg-date">{date}</time>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <!-- 空状态 -->
    <div class="blg-empty" id="blg-empty" style="display:none">
      <div class="empty-art">
        <span class="empty-icon"><Icon name="mug-hot" size={36} /></span>
        <span class="empty-dot"></span>
        <span class="empty-dot"></span>
        <span class="empty-dot"></span>
      </div>
      <p class="empty-text">没有找到匹配的文章</p>
      <p class="empty-hint">试试换个关键词或清空筛选</p>
    </div>

    <!-- 数字导航 -->
    <nav class="blg-pager" id="blg-pager">
      <button class="blg-pg-btn" id="blg-prev" disabled><Icon name="arrow-left" size={14} /></button>
      <div id="blg-pg-nums"></div>
      <button class="blg-pg-btn" id="blg-next"><Icon name="arrow-right" size={14} /></button>
    </nav>
    </div>

    <!-- 右侧竖列：随机视频 + 最近文章 + 有趣卡片 -->
    <aside class="blg-sidebar" id="blg-sidebar">
      <div class="blg-sidebar-inner">
        <!-- 标签 -->
        <div class="blg-sidebar-section">
          <div class="blg-sidebar-title-row">
            <h3 class="blg-sidebar-title">标签</h3>
          </div>
          <div class="blg-sidebar-tags">
            {allTags.map(tag => (
              <button class="blg-sidebar-tag-btn" data-tag={tag}>{tag}</button>
            ))}
          </div>
        </div>

        <!-- 随机视频 -->
        <div class="blg-sidebar-section">
          <div class="blg-sidebar-title-row">
            <h3 class="blg-sidebar-title">随机视频</h3>
            <button class="sidebar-video-refresh" id="sidebar-video-refresh" aria-label="换一个">
              <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
            </button>
          </div>
          <div class="sidebar-video" id="sidebar-video">
            <video class="sidebar-video-player" id="sidebar-video-player" controls playsinline></video>
          </div>
        </div>

        <!-- 最近发布 -->
        <div class="blg-sidebar-section">
          <h3 class="blg-sidebar-title">最近发布</h3>
          <div class="blg-sidebar-list">
            {posts.slice(0, 6).map(p => (
              <a href={'/blog/' + p.slug} class="blg-sidebar-link">
                <span class="blg-sidebar-tag" style={`background:${p.data.color||'#0040ff'}`}>{p.data.tag}</span>
                <span class="blg-sidebar-text">{p.data.title}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 有趣卡片 -->
        <div class="blg-sidebar-section">
          <h3 class="blg-sidebar-title">有趣卡片</h3>
          <div class="blg-fun-card" id="blg-fun-card">
            <div class="fun-card-emoji">🥷</div>
            <p class="fun-card-quote" id="fun-quote">代码是写给人看的，顺便能在机器上运行。</p>
            <p class="fun-card-author">— SICP</p>
          </div>
        </div>
      </div>
    </aside>
    </div>
  </main>

  <!-- 侧边栏展开按钮 -->
  <button class="blg-sidebar-toggle" id="blg-sidebar-toggle" aria-label="展开侧边栏" title="展开侧边栏">
    <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M4 6h16v2H4zm0 5h12v2H4zm0 5h8v2H4z"/></svg>
  </button>

  <Footer />
  <FloatingButtons />
</BaseLayout>

<script define:vars={{ ITEMS_PER_PAGE, totalPages }}>
  (function(){
    var isMobile = window.innerWidth < 769;
    var pp = isMobile ? 5 : ITEMS_PER_PAGE;
    var tp = Math.ceil(document.querySelectorAll('.blg-card').length / pp);
    var cards=[].slice.call(document.querySelectorAll('.blg-card'));
    var tag='全部',query='',page=1,list=cards;

    // 动态生成分页按钮
    var pgNums=document.getElementById('blg-pg-nums');
    var pgPager=document.getElementById('blg-pager');
    if(tp<=1&&pgPager){pgPager.style.display='none';}
    else if(pgNums){
      for(var i=0;i<tp;i++){
        var btn=document.createElement('button');
        btn.className='blg-pg-num'+(i===0?' on':'');
        btn.dataset.page=i+1;
        btn.textContent=i+1;
        btn.addEventListener('click',function(){page=+this.dataset.page;render(true)});
        pgNums.appendChild(btn);
      }
    }

    // 搜索
    var searchInput=document.getElementById('blg-search');
    var searchTimer;
    searchInput.addEventListener('input',function(){
      clearTimeout(searchTimer);
      searchTimer=setTimeout(function(){
        query=searchInput.value.trim().toLowerCase();
        applyFilters();
      },250);
    });

    function applyFilters(){
      list=cards.filter(function(c){
        var matchTag=tag==='全部'||c.dataset.tag===tag;
        var matchSearch=!query||(c.textContent||'').toLowerCase().indexOf(query)>-1;
        return matchTag&&matchSearch;
      });
      document.getElementById('blg-num').textContent=list.length+' 篇';
      document.getElementById('blg-num').classList.add('animate-count');
      page=1;render(false);
    }

    document.querySelectorAll('.blg-chip').forEach(function(c){c.addEventListener('click',function(){
      tag=this.dataset.tag;document.querySelectorAll('.blg-chip').forEach(function(x){x.classList.remove('on')});this.classList.add('on');
      applyFilters();render(true);
    })});

    // 侧边栏标签点击同步
    document.querySelectorAll('.blg-sidebar-tag-btn').forEach(function(btn){
      btn.addEventListener('click',function(){
        tag=this.dataset.tag;
        document.querySelectorAll('.blg-chip').forEach(function(x){x.classList.remove('on')});
        document.querySelector('.blg-chip[data-tag="'+tag+'"]').classList.add('on');
        document.querySelectorAll('.blg-sidebar-tag-btn').forEach(function(x){x.classList.remove('active')});
        this.classList.add('active');
        applyFilters();render(true);
      });
    });

    function render(doScroll){
      var t=Math.ceil(list.length/pp)||1,s=(page-1)*pp,e=s+pp;
      // 淡出所有卡片
      cards.forEach(function(c){
        c.style.opacity='0';
        c.style.transform='translateY(10px) scale(0.98)';
        c.style.display='none';
      });
      // 延迟后淡入匹配的卡片
      var visible=list.slice(s,e);
      setTimeout(function(){
        visible.forEach(function(c,i){
          c.style.display='';
          setTimeout(function(){
            c.style.opacity='1';
            c.style.transform='translateY(0) scale(1)';
          },i*60);
        });
      },50);
      document.querySelectorAll('.blg-pg-num').forEach(function(n){n.classList.toggle('on',+n.dataset.page===page)});
      document.getElementById('blg-prev').disabled=page===1;
      document.getElementById('blg-next').disabled=page===t;
      document.getElementById('blg-empty').style.display=list.length===0?'flex':'none';
      if(doScroll){var target=document.getElementById('blog-content');if(target){var top=target.getBoundingClientRect().top+window.scrollY-20;window.scrollTo({top:top,behavior:'smooth'});}}
    }

    // `/` 键聚焦搜索
    document.addEventListener('keydown',function(e){
      if(e.key==='/'&&document.activeElement!==searchInput&&document.activeElement.tagName!=='INPUT'&&document.activeElement.tagName!=='TEXTAREA'){
        e.preventDefault();searchInput.focus();
      }
    });

    document.getElementById('blg-prev').addEventListener('click',function(){if(page>1){page--;render(true)}});
    document.getElementById('blg-next').addEventListener('click',function(){if(page<tp){page++;render(true)}});
    render(false);

    // 滚动渐显 — 功能栏、卡片、分页先后淡入
    // rootMargin 负值使元素需进入视口更深才触发，确保波浪隔开足够距离
    var revealEls = document.querySelectorAll('.blg-bar,.blg-grid,.blg-pager');
    var revealObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('visible'); revealObs.unobserve(e.target); } });
    },{threshold:0.08,rootMargin:'-40px 0px 0px 0px'});
    revealEls.forEach(function(el){ revealObs.observe(el); });
  })();

  // 侧边栏展开/收起
  (function () {
    var sidebar = document.getElementById('blg-sidebar');
    var toggleBtn = document.getElementById('blg-sidebar-toggle');
    var blgContent = document.getElementById('blog-content');
    if (!sidebar || !toggleBtn) return;

    toggleBtn.addEventListener('click', function () {
      var isOpen = sidebar.classList.toggle('open');
      if (blgContent) blgContent.classList.toggle('has-sidebar', isOpen);
      toggleBtn.innerHTML = isOpen
        ? '<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>'
        : '<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M4 6h16v2H4zm0 5h12v2H4zm0 5h8v2H4z"/></svg>';
      toggleBtn.setAttribute('aria-label', isOpen ? '收起侧边栏' : '展开侧边栏');
      // 关闭侧边栏时暂停视频
      if (!isOpen) {
        var video = document.getElementById('sidebar-video-player');
        if (video) video.pause();
      }
    });

    // 滚动显示/隐藏按钮（和回到顶部按钮同步）
    window.addEventListener('scroll', function () {
      if (window.scrollY > 300) {
        toggleBtn.classList.add('show');
      } else {
        toggleBtn.classList.remove('show');
      }
    }, { passive: true });
  })();

  // 随机视频
  (function () {
    var VIDEO_API = 'https://api.kuleu.com/api/MP4_xiaojiejie?type=json';
    var videoEl = document.getElementById('sidebar-video-player');
    var refreshBtn = document.getElementById('sidebar-video-refresh');
    if (!videoEl || !refreshBtn) return;

    function loadVideo(autoPlay) {
      // 加时间戳破坏缓存，确保每次获取不同视频
      var url = VIDEO_API + '&t=' + Date.now();
      fetch(url)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data && data.mp4_video) {
            videoEl.src = data.mp4_video;
            videoEl.load();
            if (autoPlay) videoEl.play().catch(function() {});
          }
        })
        .catch(function() {});
    }

    refreshBtn.addEventListener('click', function() {
      videoEl.pause();
      loadVideo(true);
    });

    // 播放结束自动下一个
    videoEl.addEventListener('ended', function() {
      loadVideo(true);
    });

    loadVideo(false);
  })();

  // 随机语录
  (function () {
    var quotes = [
      { text:'代码是写给人看的，顺便能在机器上运行。', author:'SICP' },
      { text:'世界上只有两种东西是无限的：宇宙和人类的愚蠢。', author:'爱因斯坦' },
      { text:'任何足够先进的技术，都与魔法无异。', author:'克拉克' },
      { text:'简单是终极的复杂。', author:'达芬奇' },
      { text:'你不能通过盯着路来预测未来。', author:'彼得·德鲁克' },
      { text:'生活就像骑自行车，要想保持平衡就得不断前进。', author:'爱因斯坦' },
      { text:'最大的风险就是不冒任何风险。', author:'扎克伯格' },
      { text:'做或不做，没有尝试。', author:'尤达大师' },
    ];
    var i = Math.floor(Math.random() * quotes.length);
    var q = quotes[i];
    var quoteEl = document.getElementById('fun-quote');
    var authorEl = document.querySelector('.fun-card-author');
    if (quoteEl) quoteEl.textContent = q.text;
    if (authorEl) authorEl.textContent = '— ' + q.author;
  })();

</script>

<style>
  /* === 固定视频背景 === */
  .blog-hero-fixed {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 0;
    background: #000;
  }
  .blog-hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.4) 100%);
  }

  /* === Hero 内容 === */
  .blog-hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px;
  }
  .hero-tag {
    font-size: 0.7rem;
    letter-spacing: 6px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 24px;
    text-transform: uppercase;
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .hero-line {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.1;
    text-shadow: 0 2px 30px rgba(0,0,0,0.4);
  }
  .hero-cursive {
    font-style: italic;
    font-weight: 300;
    letter-spacing: -3px;
    font-size: clamp(3rem, 8vw, 7rem);
  }
  .hero-divider {
    width: 60px;
    height: 1px;
    background: rgba(255,255,255,0.4);
    margin: 0 auto 20px;
  }
  .hero-sub {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.7);
    letter-spacing: 3px;
    text-shadow: 0 1px 10px rgba(0,0,0,0.3);
  }
  .hero-scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.5);
    font-size: 0.6rem;
    letter-spacing: 4px;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, rgba(255,255,255,0.5), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }
  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.2); }
  }

  /* === 电影入场动画 === */
  .anim-fade-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  .anim-scale-x {
    transform: scaleX(0);
    animation: scaleX 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes scaleX {
    to { transform: scaleX(1); }
  }

  /* === 噪点纹理叠加 === */
  .blg::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
  }

  /* === 卡片入场波浪效果 === */
  .blg-card { opacity:0; transform:translateY(30px) scale(0.98); transition:opacity 0.6s ease, transform 0.6s cubic-bezier(0.22,1,0.36,1); position:relative; overflow:visible; }
  .blg-card.visible { opacity:1; transform:translateY(0) scale(1); }

  /* 卡片阴影 */
  .blg-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: -1;
  }
  .blg-card:hover::before {
    opacity: 0;
  }

  /* 光追随 — 仅在文字区域显示 */
  .blg-overlay {
    position: relative;
    overflow: hidden;
  }
  .blg-overlay::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,64,255,0.18) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    left: var(--mx, 50%);
    top: var(--my, 50%);
    transform: translate(-50%, -50%);
    z-index: 0;
  }
  :global([data-theme="dark"]) .blg-overlay::after {
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  }
  .blg-card:hover .blg-overlay::after {
    opacity: 1;
  }

  /* === 骨架屏加载 === */
  .blg-skeleton {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 36px;
  }
  .skeleton-card {
    border-radius: 18px;
    overflow: hidden;
    background: rgba(128,128,128,0.06);
  }
  .skeleton-img {
    height: 240px;
