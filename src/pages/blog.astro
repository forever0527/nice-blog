<script>
  // 卡片光追随效果 — 仅在文字区域
  (function() {
    var cards = document.querySelectorAll('.blg-card');
    cards.forEach(function(card) {
      var overlay = card.querySelector('.blg-overlay');
      if (!overlay) return;
      card.addEventListener('mousemove', function(e) {
        var rect = overlay.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        overlay.style.setProperty('--mx', x + 'px');
        overlay.style.setProperty('--my', y + 'px');
      });
    });
  })();
</script>

<script>
  // 卡片 stagger 入场动画
  (function() {
    var cards = document.querySelectorAll('.blg-card');
    if (!cards.length) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function() {
            entry.target.classList.add('visible');
          }, i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach(function(card) {
      observer.observe(card);
    });
  })();
</script>

<script>
  // 骨架屏隐藏
  (function() {
    var skeleton = document.getElementById('blg-skeleton');
    if (skeleton) {
      setTimeout(function() {
        skeleton.style.opacity = '0';
        skeleton.style.transition = 'opacity 0.3s ease';
        setTimeout(function() { skeleton.style.display = 'none'; }, 300);
      }, 500);
    }
  })();
</script>

<script>
  // 固定视频背景 + 内容滚动覆盖
  (function() {
    var fixedBg = document.querySelector('.blog-hero-fixed');
    var heroSection = document.querySelector('.blog-hero-section');
    var heroContent = document.querySelector('.hero-content');
    var heroOverlay = document.querySelector('.hero-overlay');
    var scrollHint = document.querySelector('.hero-scroll-hint');
    if (!fixedBg || !heroSection) return;

    window.addEventListener('scroll', function() {
      var scrollTop = window.scrollY;
      var heroH = heroSection.offsetHeight;

      if (scrollTop < heroH) {
        var progress = scrollTop / heroH;

        // 文字向上移动 + 淡出
        if (heroContent) {
          heroContent.style.transform = 'translateY(' + (progress * -100) + 'px)';
          heroContent.style.opacity = 1 - progress * 2;
        }

        // 滚动提示淡出
        if (scrollHint) {
          scrollHint.style.opacity = 1 - progress * 3;
        }

        // 遮罩加深
        if (heroOverlay) {
          heroOverlay.style.opacity = 0.3 + progress * 0.5;
        }
      }

      // 内容区滚动到视频位置时隐藏视频
      if (scrollTop >= heroH - 100) {
        fixedBg.style.opacity = '0';
        fixedBg.style.transition = 'opacity 0.3s ease';
      } else {
        fixedBg.style.opacity = '1';
        fixedBg.style.transition = 'opacity 0.3s ease';
      }

      // 回到顶部时恢复
      if (scrollTop === 0) {
        fixedBg.style.opacity = '1';
        if (heroContent) {
          heroContent.style.transform = 'translateY(0)';
          heroContent.style.opacity = '1';
        }
      }
    }, { passive: true });
  })();
</script>
