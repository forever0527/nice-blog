---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import HeroTitle from '../components/HeroTitle.astro';
import { photos } from '../content/photos';

const N = photos.length;
const COPIES = 10;
const pool = Array.from({ length: COPIES }, () => photos).flat();
const GRID_COPIES = 3;
const gridPool = Array.from({ length: GRID_COPIES }, () => photos).flat();

const poses = [
  { x: 5,  r: -8,  z: 1 },
  { x: 16, r: -4,  z: 2 },
  { x: 27, r: 2,   z: 3 },
  { x: 38, r: -6,  z: 4 },
  { x: 49, r: 4,   z: 5 },
  { x: 60, r: -3,  z: 4 },
  { x: 71, r: 6,   z: 3 },
  { x: 82, r: -2,  z: 2 },
];
---

<BaseLayout title="Photo - 懒得取名">
  <Snow />
  <Header />

  <main class="photo-page desktop-layout" id="photo-page">
    <div class="photo-timeline-left" id="photo-timeline-left">
      {photos.map((p, i) => (
        <a class="timeline-label" href={`#photo-${i}`}>{p.year}</a>
      ))}
    </div>
    <div class="photo-timeline-right" id="photo-timeline-right">
      {photos.map((p, i) => (
        <a class="timeline-label" href={`#photo-${i}`}>{p.month}</a>
      ))}
    </div>

    <HeroTitle title="旅途中的一瞬间" subtitle="那些被镜头定格的时光，是旅途中最温柔的记忆" />

    <section class="slant-hero" id="slant-hero">
      <div class="slider" id="slider">
        <div class="slide-track" id="slide-track">
          {pool.map((p, i) => {
            const parity = i % 2 === 0 ? 'even' : 'odd';
            return (
              <article class={`slide ${parity}`} data-src={p.src} data-group={String(i % N)}>
                <div class="slide-image">
                  <img src={p.src} alt={p.title} loading="lazy" decoding="async" />
                </div>
                <p class="slide-overlay">
                  <span class="slide-title">{p.title}</span>
                  <span class="slide-date">{p.year}.{p.month}.{p.day}</span>
                </p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="photo-grid-section">
      <div class="photo-grid">
        {gridPool.map((p, i) => (
          <a href={`/photo/${p.slug}`} class={`photo-grid-item item-${i % N}`} id={`photo-${i}`}>
            <img src={p.src} alt={p.title} loading="lazy" decoding="async" />
            <span class="photo-grid-side-date left">{p.year}</span>
            <span class="photo-grid-side-date right">{p.month}.{p.day}</span>
            <div class="photo-grid-info">
              <div class="photo-grid-info-title">{p.title}</div>
              <div class="photo-grid-info-date">{p.year}.{p.month}.{p.day}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <main class="photo-page mobile-layout" id="photo-page-m">
    <HeroTitle title="旅途中的一瞬间" subtitle="那些被镜头定格的时光，是旅途中最温柔的记忆" />
    <div class="cascade-stage" id="cascade-stage">
      {photos.map((p, i) => {
        const pose = poses[i];
        return (
          <a href={`/photo/${p.slug}`} class="cascade-card" id={`card-${i}`} data-index={String(i)} data-src={p.src}
            style={`--x:${pose.x}%;--r:${pose.r}deg;--z:${pose.z};--i:${i}`}>
            <div class="cascade-card-inner">
              <img src={p.src} alt={p.title} loading="lazy" decoding="async" />
              <div class="cascade-card-text">
                <span class="cascade-card-title">{p.title}</span>
                <span class="cascade-card-date">{p.year}.{p.month}.{p.day}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    <div class="cascade-overlay" id="cascade-overlay"></div>
    <button class="cascade-close" id="cascade-close" aria-label="关闭">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </main>

  <Footer />
  <FloatingButtons />

<script>
  (function () {
    if (window.innerWidth < 769) return;
    var hero = document.getElementById('slant-hero');
    var track = document.getElementById('slide-track');
    if (!hero || !track) return;

    var N = 8;
    var STEP = 320;
    var SEQ_W = N * STEP;

    var currentX = 0;
    var targetX = currentX;
    var raf;

    var dragging = false, hasDragged = false;
    var dragStartX = 0, dragStartTarget = 0, lastMouseX = 0;

    var mqReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    var reduced = mqReduced.matches;
    mqReduced.addEventListener('change', function (e) { reduced = e.matches; });

    var slides = track.querySelectorAll('.slide');

    function render() {
      track.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
    }

    function parallax() {
      var winW = window.innerWidth;
      var vc = -currentX + winW / 2;
      for (var i = 0; i < slides.length; i++) {
        var s = slides[i];
        var left = s.offsetLeft + currentX;
        if (left < -500 || left > winW + 500) continue;
        var sc = s.offsetLeft + s.offsetWidth / 2;
        var px = (sc - vc) * -0.25;
        var img = s.querySelector('img');
        if (img) img.style.transform = 'translateX(' + px + 'px) scale(2.25)';
      }
    }

    function loop() {
      if (currentX > 0) { currentX -= SEQ_W; targetX -= SEQ_W; }
      if (currentX < -SEQ_W * 3) { currentX += SEQ_W; targetX += SEQ_W; }
      if (reduced) { currentX = targetX; }
      else { currentX += (targetX - currentX) * 0.08; }
      render();
      parallax();
      raf = requestAnimationFrame(loop);
    }

    hero.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      var r = hero.getBoundingClientRect();
      var bandTop = r.top + r.height * 0.35;
      var bandBot = r.bottom - r.height * 0.35;
      if (e.clientY < bandTop || e.clientY > bandBot) return;
      e.preventDefault();
      targetX -= Math.max(-150, Math.min(e.deltaY * 1.75, 150));
    }, { passive: false });

    hero.addEventListener('mousedown', function (e) {
      e.preventDefault();
      dragging = true; hasDragged = false;
      dragStartX = e.clientX; lastMouseX = e.clientX; dragStartTarget = targetX;
    });

    document.addEventListener('mousemove', function (e) {
      if (!dragging) return;
      targetX += (e.clientX - lastMouseX) * 2;
      lastMouseX = e.clientX;
      if (Math.abs(targetX - dragStartTarget) > 5) hasDragged = true;
    });

    function endDrag() {
      if (!dragging) return;
      dragging = false;
      setTimeout(function () { hasDragged = false; }, 100);
    }
    document.addEventListener('mouseup', endDrag);
    hero.addEventListener('mouseleave', endDrag);
    hero.addEventListener('dragstart', function (e) { e.preventDefault(); });

    hero.addEventListener('touchstart', function (e) {
      dragging = true; hasDragged = false;
      dragStartX = e.touches[0].clientX; dragStartTarget = targetX;
    });
    hero.addEventListener('touchmove', function (e) {
      if (!dragging) return;
      targetX = dragStartTarget + (e.touches[0].clientX - dragStartX) * 1.5;
      if (Math.abs(e.touches[0].clientX - dragStartX) > 5) hasDragged = true;
    });
    hero.addEventListener('touchend', function () {
      dragging = false;
      setTimeout(function () { hasDragged = false; }, 100);
    });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (window.innerWidth < 769) return;
        while (currentX > 0) currentX -= SEQ_W;
        while (currentX < -SEQ_W * 3) currentX += SEQ_W;
        targetX = currentX;
        render();
        parallax();
      }, 150);
    });

    raf = requestAnimationFrame(loop);
  })();
</script>

<script>
  (function () {
    var stage = document.getElementById('cascade-stage');
    var overlay = document.getElementById('cascade-overlay');
    var closeBtn = document.getElementById('cascade-close');
    if (!stage || !overlay || !closeBtn) return;
    var cards = stage.querySelectorAll('.cascade-card');
    var activeIdx = -1;
    function openCard(idx) {
      activeIdx = idx;
      cards.forEach(function (c, i) { i === idx ? c.classList.add('active') : c.classList.add('dimmed'); });
      overlay.classList.add('show'); closeBtn.classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeCard() {
      activeIdx = -1;
      cards.forEach(function (c) { c.classList.remove('active', 'dimmed'); });
      overlay.classList.remove('show'); closeBtn.classList.remove('show');
      document.body.style.overflow = '';
    }
    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        e.stopPropagation();
        var idx = parseInt(card.dataset.index);
        if (activeIdx === idx) { closeCard(); return; }
        if (activeIdx >= 0) closeCard();
        setTimeout(function () { openCard(idx); }, 80);
      });
    });
    overlay.addEventListener('click', closeCard);
    closeBtn.addEventListener('click', closeCard);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && activeIdx >= 0) closeCard(); });
  })();
</script>

<script>
  (function () {
    var tl = document.getElementById('photo-timeline-left');
    var tr = document.getElementById('photo-timeline-right');
    var hero = document.getElementById('slant-hero');
    if (!tl || !tr || !hero) return;

    function checkTimeline() {
      var heroRect = hero.getBoundingClientRect();
      var inView = heroRect.top < window.innerHeight * 0.6 && heroRect.bottom > window.innerHeight * 0.2;
      tl.classList.toggle('hidden', inView);
      tr.classList.toggle('hidden', inView);
    }

    window.addEventListener('scroll', checkTimeline, { passive: true });
    checkTimeline();
  })();

  (function () {
    var items = document.querySelectorAll('.photo-grid-item');
    if (!items.length) return;

    items.forEach(function (item, i) {
      item.style.setProperty('--d', (i % 6) * 0.06 + 's');
    });

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('mosaic-in');
        }
      });
    }, { threshold: 0.05 });

    items.forEach(function (item) { observer.observe(item); });
  })();
</script>

</BaseLayout>

<style>
  .photo-page {
    width: 100%;
    min-height: 100vh;
    scroll-behavior: smooth;
    position: relative;
  }
  .photo-page::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: -1;
    pointer-events: none;
  }

  .photo-grid-section {
    padding: 0 5vw 40px;
    width: 100%;
    position: relative;
  }

  .photo-timeline-left,
  .photo-timeline-right {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 200;
    transition: opacity 0.4s ease;
  }

  .photo-timeline-left {
    left: 16px;
  }

  .photo-timeline-right {
    right: 16px;
  }

  .timeline-label {
    font-size: 0.75rem;
    color: var(--text);
    opacity: 0.7;
    letter-spacing: 2px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .timeline-label:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .photo-timeline-left.hidden,
  .photo-timeline-right.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 300px);
    grid-auto-rows: 420px;
    gap: 120px;
    justify-content: center;
    padding: 0 80px;
  }

  .photo-grid-item {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    min-height: 0;
    scroll-margin-top: 80px;
    transition: transform 0.3s ease, opacity 0.6s ease var(--d, 0s);
    opacity: 0;
    text-decoration: none;
    display: block;
  }
  .photo-grid-item.mosaic-in {
    opacity: 1;
  }

  .photo-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
    transition: transform 0.5s ease;
  }

  .photo-grid-item:hover img {
    transform: scale(1.05);
  }

  .photo-grid-side-date {
    position: absolute;
    writing-mode: vertical-rl;
    color: var(--text);
    opacity: 0.25;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 2px;
    transition: opacity 0.3s ease;
  }

  .photo-grid-item:hover .photo-grid-side-date {
    opacity: 0.6;
  }

  .photo-grid-side-date.left {
    left: -30px;
    top: 50%;
    transform: translateY(-50%);
  }

  .photo-grid-side-date.right {
    right: -30px;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
  }

  .photo-grid-info {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
    text-shadow: 0 2px 8px rgba(0,0,0,0.7);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .photo-grid-item:hover .photo-grid-info {
    opacity: 1;
  }

  .photo-grid-info-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .photo-grid-info-date {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .item-0 { transform: rotate(-1.5deg) translateX(-20px); }
  .item-1 { transform: rotate(1.8deg) translateY(10px); }
  .item-2 { transform: rotate(-0.8deg) translateY(-8px); }
  .item-3 { transform: rotate(2.2deg) translateY(6px); }
  .item-4 { transform: rotate(-1.2deg) translateX(20px) translateY(-4px); }
  .item-5 { transform: rotate(0.6deg) translateY(12px); }
  .item-6 { transform: rotate(-2deg) translateY(-10px); }
  .item-7 { transform: rotate(1.4deg) translateX(-20px) translateY(8px); }

  .photo-grid-item:hover {
    transform: rotate(0deg) !important;
    z-index: 2;
  }

  .mobile-layout { display: none; }
  .desktop-layout {
    min-height: 100vh;
  }

  .slant-hero {
    height: 60vh;
    margin-top: 0;
    margin-bottom: 80px;
    position: relative;
    cursor: grab;
  }

  .slant-hero:active { cursor: grabbing; }

  .slider {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 320px;
    transform: translateY(-50%);
    overflow: visible;
    user-select: none;
  }
  .slider:active { cursor: grabbing; }

  .slide-track {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    display: flex;
    align-items: center;
    will-change: transform;
  }

  .slide {
    flex-shrink: 0;
    width: 240px;
    margin: 0 40px;
    position: relative;
    overflow: visible;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .slide.even { transform: translateY(-4vh); }
  .slide.odd  { transform: translateY(4vh); }

  .slide-image {
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 16px;
    position: relative;
  }

  .slide-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform: scale(2.25);
    user-select: none;
    pointer-events: none;
    border-radius: 16px;
  }

  .slide-overlay {
    margin: 4px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    position: relative;
    z-index: 10;
  }
  .slide:hover .slide-overlay { opacity: 1; }

  .slide-title {
    font-family: 'Georgia','Noto Serif SC',serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--text);
  }
  .slide-date {
    font-family: 'Georgia',serif;
    font-size: 0.7rem;
    opacity: 0.5;
    font-style: italic;
    letter-spacing: 1px;
    color: var(--text);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider { transform: none; width: 100%; left: 0; top: 0; bottom: 0; }
    .slide-image img { transform: scale(1); }
    .slide.even, .slide.odd { transform: translateY(-50%); }
  }

  @media (max-width: 768px) {
    .desktop-layout { display: none; }
    .mobile-layout { display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }

    .cascade-stage {
      position: relative; width: 96vw; height: 400px;
      display: flex; align-items: center; justify-content: center; z-index: 1;
    }
    .cascade-card {
      position: absolute; width: 180px;
      transition: transform .5s cubic-bezier(.32,1,.32,1), filter .45s, opacity .45s, z-index 0s .3s;
      transform: translateX(calc(var(--x) - 50%)) rotate(var(--r)) translateY(calc(var(--i) * 4px - 12px));
      z-index: var(--z); cursor: pointer;
      -webkit-tap-highlight-color: transparent; user-select: none;
      text-decoration: none;
      color: inherit;
    }
    .cascade-card.dimmed { cursor: default; }
    .cascade-card.active { cursor: default; }
    .cascade-card-inner {
      display: block; width: 100%;
      border-radius: 14px; overflow: hidden;
      box-shadow: 3px 3px 8px var(--nav-edge), 1px 1px 3px var(--nav-edge);
    }
    .cascade-card img { display: block; width: 100%; height: 250px; object-fit: cover; }
    .cascade-card-text { padding: 10px 14px 12px; background: transparent; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    :global([data-theme="dark"]) .cascade-card-text { background: transparent; }
    .cascade-card-title {
      display: block;
      font-family: 'Georgia','Noto Serif SC','STSong','KaiTi',serif;
      font-size: .85rem; font-weight: 600; letter-spacing: 1.5px; color: var(--text);
    }
    .cascade-card-date {
      display: block; margin-top: 2px;
      font-family: 'Georgia',serif; font-size: .62rem; opacity: .4;
      font-style: italic; letter-spacing: 1px; color: var(--text);
    }

    .cascade-card.active {
      top: 50% !important; left: 50% !important;
      transform: translate(-50%, -50%) rotate(0deg) !important;
      z-index: 100 !important; width: 280px; cursor: default;
      transition: transform .5s cubic-bezier(.32,1,.32,1), filter .4s, opacity .4s, width .45s cubic-bezier(.32,1,.32,1), z-index 0s 0s;
    }
    .cascade-card.active .cascade-card-inner {
      box-shadow: 0 16px 48px rgba(0,0,0,.16), 0 0 0 1px rgba(0,64,255,.08), 0 0 60px rgba(0,64,255,.04);
      max-height: 80vh; display: flex; flex-direction: column;
    }
    .cascade-card.active img { height: 360px; flex-shrink: 0; }
    .cascade-card.active .cascade-card-text {
      max-height: 120px; overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    .cascade-card.dimmed { filter: blur(3px); opacity: .4; pointer-events: none; }

    .cascade-overlay {
      position: fixed; inset: 0; z-index: 90;
      background: rgba(0,0,0,.35);
      opacity: 0; pointer-events: none; transition: opacity .4s;
    }
    .cascade-overlay.show { opacity: 1; pointer-events: auto; }
    .cascade-close {
      position: fixed; top: 90px; right: 20px; z-index: 110;
      width: 32px; height: 32px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,.25);
      background: rgba(0,0,0,.4); color: #fff;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity .3s, transform .3s;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .cascade-close.show { opacity: 1; pointer-events: auto; }
    .cascade-close:hover { background: rgba(0,0,0,.6); transform: scale(1.1); }
  }
</style>
