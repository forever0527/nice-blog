---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import HeroTitle from '../components/HeroTitle.astro';
import aigcData from '../content/aigc.json';

const works = aigcData.works;
const subtitle = aigcData.subtitle;
---

<BaseLayout title="AIGC - 懒得取名">
  <Snow />
  <Header />

  <main class="page">
    <HeroTitle title="AIGC" subtitle={subtitle} />

    <div class="gallery" id="aigc-gallery" aria-label="AI 生成作品集">
      {works.map((w, i) => (
        <figure class="card reveal" style={`--i: ${i}`}>
          <div class="card-img">
            <img src={w.src} alt={w.title} loading="lazy" decoding="async" />
          </div>
          <figcaption class="card-caption">
            <div class="card-tag-row">
              <span class="card-tag">{w.tag}</span>
              <span class="card-model">{w.model}</span>
            </div>
            <h3 class="card-title">{w.title}</h3>
          </figcaption>
        </figure>
      ))}
    </div>
    <nav class="aigc-pager" id="aigc-pager">
      <button class="aigc-pg-btn" id="aigc-prev" disabled>&#8592;</button>
      <div id="aigc-pg-nums"></div>
      <button class="aigc-pg-btn" id="aigc-next">&#8594;</button>
    </nav>
  </main>

  <Footer />
  <FloatingButtons />
</BaseLayout>

<style is:global>
  .page {
    width: 100%;
    min-height: calc(100vh - 76px);
    background: transparent;
    padding: 40px clamp(20px, 4vw, 48px) 120px;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .gallery { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (max-width: 540px) {
    .gallery { grid-template-columns: 1fr; }
  }

  .card {
    border-radius: 18px;
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(120,120,120,0.5);
    transition: border-color 0.3s ease, transform 0.35s cubic-bezier(0.22,0.61,0.36,1);
    cursor: pointer;
    box-shadow: 3px 3px 10px var(--nav-edge), 1px 1px 3px var(--nav-edge);
  }
  :global([data-theme="dark"]) .card {
    border-color: rgba(80,90,110,0.4);
  }
  .card:hover {
    border-color: rgba(0,64,255,0.25);
    box-shadow: 0 16px 40px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,64,255,0.04);
    transform: translateY(-2px);
  }
  :global([data-theme="dark"]) .card:hover {
    box-shadow: 0 16px 40px rgba(0,0,0,0.3), 0 0 0 1px rgba(0,64,255,0.06);
  }
  .card:focus-visible {
    outline: 2px solid #0040ff;
    outline-offset: 3px;
  }

  .card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(128,128,128,0.03);
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22,0.61,0.36,1);
  }
  .card:hover .card-img img {
    transform: scale(1.05);
  }

  .card-caption {
    padding: 18px 20px 20px;
  }
  .card-tag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .card-tag {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #0040ff;
    opacity: 0.7;
    padding: 2px 8px;
    background: rgba(0,64,255,0.06);
    border-radius: 3px;
  }
  .card-model {
    font-size: 0.7rem;
    color: var(--text);
    opacity: 0.3;
    letter-spacing: 0.5px;
  }
  .card-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.5px;
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(28px) scale(0.97);
    transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1),
                transform 0.6s cubic-bezier(0.16,1,0.3,1);
    transition-delay: calc(var(--i) * 60ms);
  }
  .reveal.visible { opacity: 1; transform: translateY(0) scale(1); }

  /* 分页 */
  .aigc-pager { display:flex; justify-content:center; align-items:center; gap:12px; margin-top:80px; opacity:0; transform:translateY(4vh); transition:opacity 0.7s ease 0.3s,transform 0.7s ease 0.3s; }
  .aigc-pager.visible { opacity:1; transform:translateY(0); }
  .aigc-pg-btn { width:38px; height:38px; border-radius:10px; border:none; background:none; color:var(--text); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:0.78rem; transition:background 0.2s; }
  .aigc-pg-btn:hover:not(:disabled) { background:rgba(128,128,128,0.08); }
  .aigc-pg-btn:disabled { opacity:0.2; cursor:default; }
  .aigc-pg-num { width:40px; height:40px; border-radius:12px; border:1px solid rgba(128,128,128,0.15); background:rgba(255,255,255,0.04); color:var(--text); font-size:0.88rem; font-weight:700; cursor:pointer; transition:all 0.25s ease; letter-spacing:0.5px; }
  .aigc-pg-num:hover { background:rgba(128,128,128,0.1); border-color:rgba(128,128,128,0.3); }
  .aigc-pg-num.on { background:#0040ff; color:#fff; border-color:#0040ff; box-shadow:0 2px 12px rgba(0,64,255,0.3); }

  @media (max-width: 768px) {
    .card { border-radius: 14px; }
    .card-caption { padding: 14px 16px; }
    .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .page { padding: 24px 16px 80px; }
    .aigc-pager { gap:4px; margin-top:60px; }
    .aigc-pg-btn { width:34px; height:34px; font-size:0.75rem; }
    .aigc-pg-num { width:34px; height:34px; font-size:0.82rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .card, .card-img img { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('.reveal').forEach(el => {
    new IntersectionObserver((es, obs) => {
      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }).observe(el);
  });

  (function(){
    if(window.innerWidth>=769)return;
    var gallery=document.getElementById('aigc-gallery');
    var pager=document.getElementById('aigc-pager');
    if(!gallery||!pager)return;
    var cards=[].slice.call(gallery.querySelectorAll('.card'));
    var pp=6,page=1;
    function render(){
      var t=Math.ceil(cards.length/pp);
      var s=(page-1)*pp;
      cards.forEach(function(c,i){
        var show=i>=s&&i<s+pp;
        c.style.display=show?'':'none';
        if(show){
          c.classList.remove('visible');
          c.style.opacity='0';c.style.transform='translateY(24px) scale(0.97)';
          setTimeout(function(){
            c.style.transition='opacity 0.5s cubic-bezier(0.16,1,0.3,1),transform 0.5s cubic-bezier(0.16,1,0.3,1)';
            c.classList.add('visible');c.style.opacity='';c.style.transform='';
          },(i-s)*60);
        }
      });
      var nums=document.getElementById('aigc-pg-nums');
      nums.innerHTML='';
      for(var i=0;i<t;i++){
        var btn=document.createElement('button');
        btn.className='aigc-pg-num'+(i===page-1?' on':'');
        btn.dataset.page=i+1;btn.textContent=i+1;
        btn.addEventListener('click',function(){page=+this.dataset.page;render();});
        nums.appendChild(btn);
      }
      document.getElementById('aigc-prev').disabled=page===1;
      document.getElementById('aigc-next').disabled=page===t;
    }
    document.getElementById('aigc-prev').addEventListener('click',function(){if(page>1){page--;render();}});
    document.getElementById('aigc-next').addEventListener('click',function(){page++;render();});
    pager.style.display='flex';
    render();
    setTimeout(function(){pager.classList.add('visible');},100);
  })();
</script>
