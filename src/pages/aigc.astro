---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import HeroTitle from '../components/HeroTitle.astro';

const works = [
  { src: '/img/bg/0-1.webp', title: '虚空之瞳', model: 'Midjourney', tag: '奇幻' },
  { src: '/img/bg/0-2.webp', title: '赛博晨光', model: 'Stable Diffusion', tag: '科幻' },
  { src: '/img/bg/0-3.webp', title: '镜花水月', model: 'DALL·E', tag: '概念' },
  { src: '/img/bg/0-4.webp', title: '极光之森', model: 'Midjourney', tag: '自然' },
  { src: '/img/bg/0-5.webp', title: '霓虹暗涌', model: 'Stable Diffusion', tag: '赛博' },
  { src: '/img/bg/0-6.webp', title: '尘埃纪元', model: 'DALL·E', tag: '末世' },
  { src: '/img/bg/1.webp',   title: '晨雾山峦', model: 'Midjourney', tag: '写实' },
  { src: '/img/bg/2.webp',   title: '深海幽光', model: 'Stable Diffusion', tag: '幻想' },
  { src: '/img/bg/3.webp',   title: '星环遗迹', model: 'DALL·E', tag: '太空' },
];
---

<BaseLayout title="AIGC - 懒得取名">
  <Snow />
  <Header />

  <main class="page">
    <HeroTitle title="AIGC" subtitle="算法与美学的交界地带。每一张都是与机器的一场沉默对谈。" />

    <div class="gallery" aria-label="AI 生成作品集">
      {works.map((w, i) => (
        <figure class="card reveal" style={`--i: ${i}`}>
          <div class="card-img">
            <img src={w.src} alt={w.title} loading="lazy" decoding="async" />
          </div>
          <figcaption class="card-caption">
            <div class="card-tag-row">
              <span class="card-tag">{w.tag}</span>
              <span class="card-model">{w.model}</span>
            </div>
            <h3 class="card-title">{w.title}</h3>
          </figcaption>
        </figure>
      ))}
    </div>
  </main>

  <Footer />
  <FloatingButtons />
</BaseLayout>

<style>
  .page {
    width: 100%;
    min-height: calc(100vh - 76px);
    background: transparent;
    padding: 0 clamp(20px, 4vw, 48px) 120px;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .gallery { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (max-width: 540px) {
    .gallery { grid-template-columns: 1fr; }
  }

  .card {
    border-radius: 18px;
    overflow: hidden;
    background: transparent;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(120,120,120,0.5);
    transition: border-color 0.3s ease, transform 0.35s cubic-bezier(0.22,0.61,0.36,1);
    cursor: pointer;
    box-shadow: 3px 3px 10px var(--nav-edge), 1px 1px 3px var(--nav-edge);
  }
  :global([data-theme="dark"]) .card {
    border-color: rgba(80,90,110,0.4);
  }
  .card:hover {
    border-color: rgba(0,64,255,0.25);
    box-shadow: 0 16px 40px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,64,255,0.04);
    transform: translateY(-2px);
  }
  :global([data-theme="dark"]) .card:hover {
    box-shadow: 0 16px 40px rgba(0,0,0,0.3), 0 0 0 1px rgba(0,64,255,0.06);
  }
  .card:focus-visible {
    outline: 2px solid #0040ff;
    outline-offset: 3px;
  }

  .card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(128,128,128,0.03);
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22,0.61,0.36,1);
  }
  .card:hover .card-img img {
    transform: scale(1.05);
  }

  .card-caption {
    padding: 18px 20px 20px;
  }
  .card-tag-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .card-tag {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #0040ff;
    opacity: 0.7;
    padding: 2px 8px;
    background: rgba(0,64,255,0.06);
    border-radius: 3px;
  }
  .card-model {
    font-size: 0.7rem;
    color: var(--text);
    opacity: 0.3;
    letter-spacing: 0.5px;
  }
  .card-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.5px;
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s cubic-bezier(0.22,0.61,0.36,1),
                transform 0.55s cubic-bezier(0.22,0.61,0.36,1);
    transition-delay: calc(var(--i) * 55ms);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
    .card { border-radius: 14px; }
    .card-caption { padding: 14px 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .card, .card-img img { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('.reveal').forEach(el => {
    new IntersectionObserver((es, obs) => {
      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }).observe(el);
  });
</script>
