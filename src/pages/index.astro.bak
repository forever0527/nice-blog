---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import Snow from '../components/Snow.astro';
import Icon from '../components/Icon.astro';
import siteData from '../content/site.json';

const profile = {
  name: siteData.name,
  title: siteData.subtitle,
  bio: siteData.bio,
  bgImage: siteData.bgImage,
};

const bgList = siteData.bgList;

const socialLinks = siteData.socialLinks;
---

<BaseLayout title={`${profile.name} - 懒得取名`}>
  <script is:inline>document.body.classList.add('index-page');</script>
  <Snow />

  <main class="landing-container" id="landing-bg">

    <div class="hero-card">

      <!-- 左侧：液态玻璃内容区 -->
      <div class="glass-content">
        <div class="content-inner">
          <div class="welcome-badge">Welcome to my world</div>

          <h1 class="hero-title">
            Hello, I'm<br>
            <span class="highlight-text">{profile.name}</span>
          </h1>

          <p class="hero-subtitle">{profile.title}</p>
          <p class="hero-bio">{profile.bio}</p>

          <!-- 交互按钮组 -->
          <div class="cta-group">
            <a href="/blog" class="liquid-btn">
              <span>Enter Blog</span>
            </a>

            <button id="change-bg-btn" class="secondary-btn">
              <Icon name="image" size={16} /> 更换图片
            </button>
          </div>

          <!-- 社交图标组 -->
          <div class="social-icons">
            {socialLinks.map((link) => (
              <span class="icon-wrap" data-tooltip={link.label}>
                <a href={link.url} target="_blank" class="icon-link" aria-label={link.label}>
                  <Icon name={link.icon} size={18} />
                </a>
              </span>
            ))}
          </div>

          <div class="mini-footer">
            <span class="mini-footer-shop"><Icon name="shopping-cart" size={14} /> 商店: {siteData.shopLinks.map((shop, i) => (<Fragment>{i > 0 && <span style="margin:0 5px">|</span>}<a href={shop.url} style="color: var(--text);">{shop.label}</a></Fragment>))}</span>
            <br>
            &copy; 2025 {profile.name}. Designed with Astro.
          </div>
        </div>
      </div>

      <!-- 右侧：视觉图片区 -->
      <div id="visual-side" class="visual-side">
      </div>

    </div>
  </main>

  <!-- 关于页面 — 展开后显示，90年代复古粗体印刷风 -->
  <div class="about-page" id="about-page">
    <a class="about-logo" href="/" target="_blank" rel="noopener">
      <img src="/img/laa/long.webp" alt="Logo" />
    </a>
    <div class="about-inner">

      <!-- Marquee 跑马灯 -->
      <div class="retro-marquee">
        <div class="marquee-track">
          <span>CREATIVE DEVELOPER</span>
          <span>★</span>
          <span>AI EXPLORER</span>
          <span>★</span>
          <span>WEBGL ARTIST</span>
          <span>★</span>
          <span>OPEN SOURCE</span>
          <span>★</span>
          <span>CREATIVE DEVELOPER</span>
          <span>★</span>
          <span>AI EXPLORER</span>
          <span>★</span>
          <span>WEBGL ARTIST</span>
          <span>★</span>
          <span>OPEN SOURCE</span>
          <span>★</span>
        </div>
      </div>

      <!-- 简介：错位图文 -->
      <section class="retro-section retro-about">
        <div class="retro-text anim-slide">
          <span class="retro-label">01 — WHO</span>
          <h2 class="retro-heading">代码即诗歌<br/>设计如数学</h2>
          <p class="retro-body">
            一个热爱创造的程序员。相信代码可以像诗歌一样优雅，设计可以像数学一样精确。目前在探索 AI 与前端技术的交汇点，用 Three.js 构建沉浸式的 Web 体验。
          </p>
        </div>
        <div class="retro-image stagger-img parallax-img" data-speed="0.1">
          <img src="/img/bg/3.webp" alt="" loading="lazy" />
        </div>
      </section>

      <!-- 技术栈：非对称网格 -->
      <section class="retro-section retro-skills">
        <span class="retro-label anim-slide">02 — STACK</span>
        <div class="skills-grid">
          <div class="skill-card anim-reveal" style="--delay:0s">
            <span class="skill-num">01</span>
            <span class="skill-name">TypeScript</span>
            <div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div>
          </div>
          <div class="skill-card anim-reveal" style="--delay:0.1s">
            <span class="skill-num">02</span>
            <span class="skill-name">React / Next.js</span>
            <div class="skill-bar"><div class="skill-fill" style="width:85%"></div></div>
          </div>
          <div class="skill-card anim-reveal" style="--delay:0.2s">
            <span class="skill-num">03</span>
            <span class="skill-name">Three.js / WebGL</span>
            <div class="skill-bar"><div class="skill-fill" style="width:75%"></div></div>
          </div>
          <div class="skill-card anim-reveal" style="--delay:0.3s">
            <span class="skill-num">04</span>
            <span class="skill-name">Node.js</span>
            <div class="skill-bar"><div class="skill-fill" style="width:80%"></div></div>
          </div>
          <div class="skill-card anim-reveal" style="--delay:0.4s">
            <span class="skill-num">05</span>
            <span class="skill-name">Python / AI</span>
            <div class="skill-bar"><div class="skill-fill" style="width:70%"></div></div>
          </div>
        </div>
      </section>

      <!-- 旅程：电影级滚动叙事 -->
      <section class="retro-section retro-journey">
        <div class="retro-text anim-slide">
          <span class="retro-label">03 — JOURNEY</span>
          <h2 class="retro-heading">时间线</h2>
        </div>
        <div class="journey-timeline">
          <div class="journey-item anim-slide">
            <span class="journey-year">2025</span>
            <div class="journey-content">
              <h3>独立开发者</h3>
              <p>探索 AI + 前端交叉领域，构建个人工具链。</p>
            </div>
          </div>
          <div class="journey-item anim-slide">
            <span class="journey-year">2024</span>
            <div class="journey-content">
              <h3>深入 WebGL</h3>
              <p>Three.js + GLSL 流体模拟与交互视觉。</p>
            </div>
          </div>
          <div class="journey-item anim-slide">
            <span class="journey-year">2023</span>
            <div class="journey-content">
              <h3>全栈之路</h3>
              <p>Node.js + 数据库 + SSR 完整闭环。</p>
            </div>
          </div>
          <div class="journey-item anim-slide">
            <span class="journey-year">2022</span>
            <div class="journey-content">
              <h3>前端入门</h3>
              <p>用 React 写出第一个完整博客。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 大图视差 -->
      <section class="retro-section retro-visual">
        <div class="retro-visual-img parallax-img" data-speed="0.2">
          <img src="/img/bg/4.webp" alt="" loading="lazy" />
        </div>
        <div class="retro-visual-overlay anim-reveal">
          <span class="retro-big-text">CREATE</span>
        </div>
      </section>

      <!-- BLUE 文字高度展开 -->
      <section class="retro-section retro-blue" id="retro-blue">
        <div class="blue-footer" id="blue-footer">
          <span class="blue-footer-left">WE CRAFT BOLD DESIGN & CLEAN CODE.</span>
          <span class="blue-footer-right">TRUE BLUE · 2025</span>
        </div>
        <div class="blue-text-wrap" id="blue-text-wrap">
          <span class="blue-text" id="blue-text">BLUE</span>
        </div>
      </section>

    </div>
  </div>
  </div>

  <!-- 展开按钮 -->
  <button class="expand-btn" id="expand-btn" aria-label="展开">
    <svg class="icon-expand" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="16 18 22 12 16 6"></polyline>
      <polyline points="8 6 2 12 8 18"></polyline>
    </svg>
    <svg class="icon-collapse" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="16 6 22 12 16 18"></polyline>
      <polyline points="8 18 2 12 8 6"></polyline>
    </svg>
  </button>

  <!-- 首页主题切换按钮 — 固定在右下，回到顶部按钮上方 -->
  <button class="index-theme-btn" id="index-theme-toggle" aria-label="切换主题">
    <svg class="index-icon-light" viewBox="0 0 24 24" width="18" height="18">
      <path fill="currentColor" d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0 1.41.996.996 0 0 0 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06z"/>
    </svg>
    <svg class="index-icon-dark" viewBox="0 0 24 24" width="18" height="18">
      <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
    </svg>
  </button>

  <FloatingButtons />
</BaseLayout>

<script>
  // 首页主题切换
  var htmlEl = document.documentElement;
  function updateIndexThemeIcon(theme) {
    var lightIcon = document.querySelector('.index-icon-light');
    var darkIcon = document.querySelector('.index-icon-dark');
    if (lightIcon && darkIcon) {
      lightIcon.style.display = theme !== 'dark' ? 'block' : 'none';
      darkIcon.style.display = theme !== 'dark' ? 'none' : 'block';
    }
  }
  updateIndexThemeIcon(htmlEl.dataset.theme || 'light');

  document.getElementById('index-theme-toggle')?.addEventListener('click', function () {
    var newTheme = htmlEl.dataset.theme === 'light' ? 'dark' : 'light';
    htmlEl.dataset.theme = newTheme;
    localStorage.setItem('theme', newTheme);
    updateIndexThemeIcon(newTheme);
    window.dispatchEvent(new Event('theme-change'));
  });

  window.addEventListener('theme-change', function () {
    updateIndexThemeIcon(htmlEl.dataset.theme || 'light');
  });

  // 卡片鼠标跟随倾斜效果 — 仅桌面端
  if (window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 769px)').matches && !('ontouchstart' in window)) {
    var heroCard = document.querySelector('.hero-card');
    if (heroCard) {
      heroCard.addEventListener('mousemove', function (e) {
        if (e.sourceCapabilities && e.sourceCapabilities.firesTouchEvents) return;
        var rect = heroCard.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        var centerX = rect.width / 2;
        var centerY = rect.height / 2;
        var rotateX = (y - centerY) / centerY * 4;
        var rotateY = (x - centerX) / centerX * -4;
        heroCard.style.transition = 'none';
        heroCard.style.transform = 'perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
      });
      heroCard.addEventListener('mouseleave', function () {
        heroCard.style.transition = 'transform 0.5s ease';
        heroCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
      });
    }
  }

  // 展开/收起卡片分裂动效
  var expandBtn = document.getElementById('expand-btn');
  var heroCardEl = document.querySelector('.hero-card');
  var aboutPage = document.getElementById('about-page');
  var isExpanded = false;
  var isAnimating = false;

  if (expandBtn && heroCardEl && aboutPage) {
    expandBtn.addEventListener('click', function () {
      if (isAnimating) return;
      isAnimating = true;
      setTimeout(function () { isAnimating = false; }, 800);

      if (isExpanded) {
        aboutPage.classList.remove('active');
        expandBtn.classList.remove('is-expanded');
        document.body.classList.remove('index-expanded');
        setTimeout(function () {
          heroCardEl.classList.remove('splitting');
          heroCardEl.classList.add('merging');
          setTimeout(function () {
            heroCardEl.classList.remove('merging');
            heroCardEl.style.transform = '';
            heroCardEl.style.transition = '';
          }, 700);
        }, 450);
      } else {
        heroCardEl.style.transform = 'none';
        heroCardEl.style.transition = 'none';
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            heroCardEl.classList.add('splitting');
            aboutPage.classList.add('active');
            expandBtn.classList.add('is-expanded');
            document.body.classList.add('index-expanded');
          });
        });
      }
      isExpanded = !isExpanded;
    });
  }

  // 首页展开时，回到顶部滚动 about-page 而非 window
  var backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', function (e) {
      if (aboutPage && aboutPage.classList.contains('active')) {
        e.stopImmediatePropagation();
        aboutPage.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }, true);
  }

  // 展开后监听 about-page 滚动，下滑超过 200px 才显示回到顶部
  if (aboutPage && backToTop) {
    aboutPage.addEventListener('scroll', function () {
      if (aboutPage.scrollTop > 200) {
        backToTop.classList.add('show');
      } else {
        backToTop.classList.remove('show');
      }
    }, { passive: true });
  }

  // 滚动动画：Intersection Observer 控制元素入场
  function initScrollAnimations() {
    if (!aboutPage) return;
    var reveals = aboutPage.querySelectorAll('.anim-reveal, .anim-slide');
    var parallaxes = aboutPage.querySelectorAll('.parallax-img');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { root: aboutPage, threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

    reveals.forEach(function (el, i) {
      el.style.transitionDelay = (i * 0.08) + 's';
      observer.observe(el);
    });

    // 视差滚动 + BLUE 文字动画
    aboutPage.addEventListener('scroll', function () {
      var scrollTop = aboutPage.scrollTop;
      var scrollHeight = aboutPage.scrollHeight - aboutPage.clientHeight;
      var scrollProgress = Math.min(scrollTop / scrollHeight, 1);

      parallaxes.forEach(function (el) {
        var speed = parseFloat(el.dataset.speed) || 0.1;
        var rect = el.getBoundingClientRect();
        var center = rect.top + rect.height / 2;
        var viewCenter = window.innerHeight / 2;
        var offset = (center - viewCenter) * speed;
        el.style.transform = 'translateY(' + offset + 'px)';
      });

      // BLUE 文字高度展开 + 页脚上移
      var blueWrap = document.getElementById('blue-text-wrap');
      var blueText = document.getElementById('blue-text');
      if (blueWrap && blueText) {
        var blueSection = document.getElementById('retro-blue');
        var blueFooter = document.getElementById('blue-footer');
        if (blueSection) {
          var sectionRect = blueSection.getBoundingClientRect();
          var sectionTop = sectionRect.top;
          var viewH = window.innerHeight;
          // 线性进度
          var progress = Math.max(0, Math.min(1, (viewH - sectionTop) / (viewH + sectionRect.height)));

          // 高度从 0 到 90vh
          var targetH = progress * 90;
          blueWrap.style.height = targetH + 'vh';

          // 动态调整字号使文字精确撑满屏幕宽度
          var wrapW = blueWrap.offsetWidth;
          if (wrapW > 0) {
            var fs = wrapW / 4.2;
            blueText.style.fontSize = fs + 'px';
          }

          // 页脚文字向上位移，逐步移出
          if (blueFooter) {
            var footerOffset = progress * -80;
            var footerOpacity = 1 - progress * 1.5;
            blueFooter.style.transform = 'translateY(' + footerOffset + 'px)';
            blueFooter.style.opacity = Math.max(0, footerOpacity);
          }
        }
      }
    }, { passive: true });
  }

  // 展开时初始化动画
  var expandBtn2 = document.getElementById('expand-btn');
  if (expandBtn2) {
    expandBtn2.addEventListener('click', function () {
      setTimeout(initScrollAnimations, 600);
    });
  }
</script>

<!-- 卡片右侧图片切换逻辑 -->
<script define:vars={{ bgList, initialBg: profile.bgImage }}>
  (function () {
    var bgImages = bgList;
    // initialBg 可能不在 bgList 中（初始图由 CSS 兜底），
    // indexOf 返回 -1 时 bgImages[-1] = undefined，updateVisualBg 会跳过
    var currentIdx = bgImages.indexOf(initialBg);
    var visualSide = document.getElementById('visual-side');
    var changeBtn = document.getElementById('change-bg-btn');

    function updateVisualBg(url) {
      if (!url) return;
      if (visualSide) visualSide.style.backgroundImage = 'url(' + url + ')';
    }

    // 初始加载 — 只更新卡片右侧图片
    updateVisualBg(bgImages[currentIdx]);

    // 点击"更换图片"按钮循环切换卡片右侧图片
    if (changeBtn) {
      changeBtn.addEventListener('click', function () {
        currentIdx = (currentIdx + 1) % bgImages.length;
        updateVisualBg(bgImages[currentIdx]);
      });
    }
  })();
</script>

<style>
  /* ==========================================================================
     首页布局 — 全屏 Hero + 液态玻璃卡片
     使用 Astro scoped 样式，确保不影响其他页面
     ========================================================================== */

  /* === 1. 全局布局 === */
  .landing-container {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  /* 背景变暗遮罩 — 通过伪元素实现，不影响内容层级 */
  .landing-container::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0);
    transition: background 0.5s ease;
    z-index: -1;
  }

  /* 深色模式下背景整体压暗 */
  :global([data-theme="dark"]) .landing-container::before {
    background: rgba(5, 5, 5, 0.7);
  }

  /* 首页主题切换按钮 — 液态玻璃圆形 */
  :global(.index-theme-btn) {
    position: fixed;
    right: 20px;
    bottom: 102px;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    color: var(--text);
    cursor: pointer;
    z-index: var(--z-toggle);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
  }

  :global([data-theme="dark"]) .index-theme-btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2), 0 0 20px rgba(0,64,255,0.05);
  }

  :global(.index-theme-btn):hover {
    transform: scale(1.1);
    border-color: rgba(0, 64, 255, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15), 0 0 30px rgba(0,64,255,0.08);
  }

  :global(.index-theme-btn):active {
    transform: scale(0.9);
  }

  :global(.index-theme-btn) svg {
    position: absolute;
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  @media (min-width: 768px) {
    :global(.index-theme-btn) {
      right: 3vw;
      bottom: 120px;
      width: 40px;
      height: 40px;
    }
    :global(.index-theme-btn) svg {
      width: 20px;
      height: 20px;
    }
  }

  /* 首页默认隐藏回到顶部按钮，展开后仅通过 .show 类控制 */
  :global(#back-to-top) { display: none !important; }
  body.index-expanded :global(#back-to-top) {
    display: flex !important;
  }
  body.index-expanded :global(#back-to-top.show) {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }

  /* 展开时隐藏主题切换按钮 */
  body.index-expanded :global(.index-theme-btn) { display: none !important; }

  /* 首页隐藏导航栏，展开后显示 */
  :global(.smart-navbar) {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  :global(.smart-navbar.nav-visible) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(body.index-page .nav-logo-overlay) {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  :global(body.index-page .nav-logo-overlay.logo-visible) {
    opacity: 1;
    pointer-events: auto;
  }

  /* === 展开按钮 === */
  :global(.expand-btn) {
    position: fixed !important;
    right: 20px !important;
    bottom: 62px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    color: var(--text);
    cursor: pointer;
    z-index: 9999;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
  }

  :global(.expand-btn):hover {
    transform: scale(1.1);
    border-color: rgba(0, 64, 255, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15), 0 0 30px rgba(0, 64, 255, 0.08);
  }

  :global(.expand-btn):active {
    transform: scale(0.9);
  }

  :global([data-theme="dark"]) .expand-btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.expand-btn) svg {
    width: 16px;
    height: 16px;
  }

  :global(.expand-btn .icon-collapse) {
    display: none;
  }

  :global(.expand-btn.is-expanded .icon-expand) {
    display: none;
  }

  :global(.expand-btn.is-expanded .icon-collapse) {
    display: block;
  }

  @media (min-width: 768px) {
    :global(.expand-btn) {
      right: 3vw !important;
      bottom: 70px;
      width: 40px;
      height: 40px;
    }
    :global(.expand-btn) svg {
      width: 20px;
      height: 20px;
    }
  }

  /* === 关于页面 — 90年代复古粗体印刷风 === */
  .about-page {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 20;
    overflow-y: auto;
    overflow-x: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease 0.5s;
    background: transparent;
    -webkit-overflow-scrolling: touch;
  }
  .about-page.active { opacity: 1; pointer-events: auto; }

  .about-logo {
    position: fixed;
    top: 30px;
    right: 40px;
    z-index: 25;
    display: block;
  }
  .about-logo img {
    height: 30px;
    filter: brightness(0);
    transition: filter 0.3s;
  }
  [data-theme="dark"] .about-logo img {
    filter: brightness(0) invert(1);
  }
  @media (min-width: 768px) {
    .about-logo { top: 40px; right: 50px; }
    .about-logo img { height: 40px; }
  }

  .about-inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  /* --- Hero --- */
  .retro-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 8vh, 80px) clamp(20px, 6vw, 80px);
    overflow: hidden;
  }
  .retro-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.4;
    margin-bottom: 24px;
    font-weight: 600;
  }
  .retro-title {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .retro-line {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--text);
    text-transform: uppercase;
  }
  .retro-line.accent {
    color: #0040ff;
    -webkit-text-stroke: 2px #0040ff;
    -webkit-text-fill-color: transparent;
  }
  :global([data-theme="dark"]) .retro-line.accent {
    color: #4d8aff;
    -webkit-text-stroke: 2px #4d8aff;
  }
  .retro-line.small {
    font-size: clamp(1.2rem, 3vw, 2.4rem);
    opacity: 0.5;
    margin-top: 12px;
  }
  .retro-hero-img {
    position: absolute;
    right: -5%;
    bottom: -10%;
    width: 45%;
    max-width: 500px;
    border-radius: 20px;
    overflow: hidden;
    opacity: 0.2;
    mask-image: linear-gradient(to top, transparent 0%, black 40%);
    -webkit-mask-image: linear-gradient(to top, transparent 0%, black 40%);
  }
  .retro-hero-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --- Marquee --- */
  .retro-marquee {
    width: 100%;
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid rgba(128,128,128,0.15);
    border-bottom: 1px solid rgba(128,128,128,0.15);
  }
  .marquee-track {
    display: flex;
    gap: 40px;
    white-space: nowrap;
    animation: marquee-scroll 20s linear infinite;
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.3;
  }
  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* --- Sections --- */
  .retro-section {
    padding: clamp(60px, 10vh, 120px) clamp(20px, 6vw, 80px);
    position: relative;
  }
  .retro-label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.3;
    margin-bottom: 20px;
    font-weight: 600;
  }
  .retro-heading {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 20px;
  }
  .retro-body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
    opacity: 0.6;
    max-width: 560px;
  }

  /* --- About: 错位图文 --- */
  .retro-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 60px);
    align-items: center;
  }
  .retro-about .retro-image {
    border-radius: 16px;
    overflow: hidden;
  }
  .retro-about .retro-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --- Skills: 非对称网格 --- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }
  .skill-card {
    background: rgba(128,128,128,0.04);
    border: 1px solid rgba(128,128,128,0.08);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .skill-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0,64,255,0.3);
  }
  .skill-card:nth-child(4),
  .skill-card:nth-child(5) {
    grid-column: span 1;
  }
  .skill-num {
    font-size: 0.65rem;
    font-weight: 700;
    color: #0040ff;
    opacity: 0.5;
    letter-spacing: 2px;
  }
  .skill-card .skill-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    opacity: 0.8;
  }
  .skill-card .skill-bar {
    height: 3px;
    border-radius: 2px;
    background: rgba(128,128,128,0.1);
    margin-top: 8px;
  }
  .skill-card .skill-fill {
    height: 100%;
    border-radius: 2px;
    background: #0040ff;
  }

  /* --- Journey --- */
  .journey-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 32px;
    border-top: 1px solid rgba(128,128,128,0.12);
  }
  .journey-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid rgba(128,128,128,0.12);
    transition: background 0.3s ease;
  }
  .journey-item:hover {
    background: rgba(128,128,128,0.03);
  }
  .journey-year {
    font-size: 2rem;
    font-weight: 900;
    color: #0040ff;
    opacity: 0.4;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .journey-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .journey-content p {
    font-size: 0.85rem;
    color: var(--text);
    opacity: 0.5;
    line-height: 1.6;
  }

  /* --- Visual: 大图视差 --- */
  .retro-visual {
    position: relative;
    height: 70vh;
    overflow: hidden;
  }
  .retro-visual-img {
    position: absolute;
    inset: -20% 0;
  }
  .retro-visual-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .retro-visual-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
  }
  .retro-big-text {
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 900;
    color: white;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* --- BLUE 文字高度展开 --- */
  .retro-blue {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    overflow: hidden;
  }
  .blue-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px clamp(20px, 4vw, 48px);
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.5;
    will-change: transform, opacity;
    flex-shrink: 0;
  }
  .blue-text-wrap {
    width: 100%;
    height: 0;
    overflow: hidden;
    will-change: height;
  }
  .blue-text {
    display: block;
    text-align: center;
    font-size: clamp(10rem, 28vw, 24rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1;
    white-space: nowrap;
  }

  /* --- 动画 --- */
  .anim-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .anim-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .anim-slide {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .anim-slide.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- 响应式 --- */
  @media (max-width: 768px) {
    .retro-about {
      grid-template-columns: 1fr;
    }
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .journey-item {
      grid-template-columns: 80px 1fr;
    }
    .retro-hero-img {
      width: 60%;
      opacity: 0.12;
    }
  }

  /* === 卡片分裂动效 — 真实裂开 === */
  .hero-card.splitting {
    overflow: visible;
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
  }

  .hero-card.splitting .glass-content {
    transform: translateX(-110vw) rotate(-10deg);
    opacity: 0;
    border-radius: 40px 0 0 40px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-right: none;
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1),
                opacity 0.4s ease 0.3s;
  }

  .hero-card.splitting .visual-side {
    transform: translateX(110vw) rotate(10deg);
    opacity: 0;
    border-radius: 0 40px 40px 0;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-left: none;
    clip-path: none;
    margin-left: 0;
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1),
                opacity 0.4s ease 0.3s;
  }

  .hero-card.merging .glass-content {
    transform: translateX(0) rotate(0deg);
    opacity: 1;
    border-radius: 0;
    box-shadow: none;
    border: none;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease;
  }

  .hero-card.merging .visual-side {
    transform: translateX(0) rotate(0deg);
    opacity: 1;
    border-radius: 0;
    box-shadow: none;
    border: none;
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
    margin-left: -110px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease;
  }

  .hero-card.merging {
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
    transition: background 0.3s ease 0.4s,
                border-color 0.3s ease 0.4s,
                box-shadow 0.3s ease 0.4s;
  }

  /* === 2. 主卡片 (Hero Card) === */
  .hero-card {
    width: 100%;
    max-width: 1000px;
    height: 70vh;
    border-radius: 40px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    position: relative;
    transform-style: preserve-3d;
    transition: box-shadow 0.3s ease;
  }
  :global([data-theme="dark"]) .hero-card {
    box-shadow: 0 25px 60px -8px rgba(255, 255, 255, 0.12);
    border-color: rgba(80, 90, 110, 0.3);
  }

  .hero-card:hover {
    box-shadow: 0 35px 70px -12px rgba(0, 0, 0, 0.7);
  }
  :global([data-theme="dark"]) .hero-card:hover {
    box-shadow: 0 35px 80px -8px rgba(255, 255, 255, 0.15);
  }

  /* === 3. 左侧：玻璃质感内容区 === */
  .glass-content {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: transparent;
    border: 1px solid rgba(120, 120, 120, 0.5);
    transition: background 0.5s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5vw;
    overflow: hidden;
    border-radius: 40px 0 0 40px;
  }

  :global([data-theme="dark"]) .glass-content {
    background: transparent;
    border-color: rgba(80, 90, 110, 0.4);
  }

  .content-inner {
    max-width: 480px;
  }

  .welcome-badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 50px;
    background: rgba(0, 64, 255, 0.1);
    color: #0040ff;
    font-weight: 600;
    font-size: 0.78rem;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  :global([data-theme="dark"]) .welcome-badge {
    color: #4d8aff;
    background: rgba(0, 64, 255, 0.15);
  }

  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
    font-weight: 800;
    margin-bottom: 12px;
    color: var(--text);
  }

  .highlight-text {
    background: linear-gradient(135deg, #0040ff 0%, #00d2ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle { font-size: 1.1rem; opacity: 0.8; margin-bottom: 1px; }
  .hero-bio { font-size: 0.88rem; opacity: 0.8; line-height: 1.6; margin-bottom: 14px; white-space: pre-line; }

  /* === 按钮组 === */
  .cta-group {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
  }

  /* 公共 hover 效果 — 按钮上浮 + 光晕 */
  :is(.liquid-btn, .secondary-btn):hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 1px 10px var(--text);
  }

  .liquid-btn {
    padding: 12px 28px;
    border-radius: 50px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .secondary-btn {
    padding: 12px 22px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--text);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global([data-theme="dark"]) .secondary-btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* === 社交图标按钮 === */
  .social-icons { display: flex; gap: 10px; }

  .icon-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  :global([data-theme="dark"]) .icon-link { background: rgba(255, 255, 255, 0.1); }

  .icon-link:hover {
    background: #0040ff;
    color: #fff;
    transform: scale(1.2) rotate(10deg);
    text-decoration: none;
  }
  /* 平台名 tooltip — 在图标下方，不跟随旋转 */
  .icon-wrap {
    position: relative;
    display: inline-flex;
  }
  .icon-wrap::after {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    background: var(--btn-bg);
    color: var(--btn-text);
    padding: 2px 8px;
    border-radius: 5px;
    font-size: 0.65rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 10;
  }
  .icon-wrap:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* === 底部信息 === */
  .mini-footer { margin-top: 20px; font-size: 0.72rem; opacity: 0.7; overflow-wrap: anywhere; word-break: break-word; }
  .mini-footer :global(svg) { display: inline; vertical-align: middle; }
  .mini-footer-shop { display: inline-flex; align-items: center; gap: 4px; }

  /* === 4. 右侧：视觉图片区 === */
  .visual-side {
    background-image: url('/img/bg/6.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
    margin-left: -110px;
    z-index: 1;
    overflow: hidden;
    border-radius: 0 40px 40px 0;
  }

  /* === 5. 响应式 — 移动端适配 === */
  @media (max-width: 900px) {
    .landing-container {
      padding: 15px;
      height: auto;
      min-height: 100dvh;
      align-items: flex-start;
    }

    .hero-card {
      height: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 350px auto;
      border-radius: 30px;
      margin-top: 10px;
    }

    /* 移动端图片在上方 — 只保留上圆角 */
    .visual-side {
      grid-row: 1;
      background-image: url('/img/ProfPic/1.webp');
      background-position: center center;
      clip-path: none;
      margin-left: 0;
      border-radius: 30px 30px 0 0;
    }

    /* 移动端内容居中 — 只保留下圆角 */
    .glass-content {
      grid-row: 2;
      padding: 32px 20px;
      text-align: center;
      border-radius: 0 0 30px 30px;
    }

    .content-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .cta-group { flex-direction: column; width: 100%; }

    .liquid-btn, .secondary-btn {
      width: 80%;
      max-width: 240px;
      margin: 0 auto;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .social-icons { justify-content: center; }

    .about-cta {
      flex-wrap: wrap;
      justify-content: center;
    }

    /* 移动端分裂动效 — 淡出而非水平飞出 */
    .hero-card.splitting .glass-content {
      transform: translateY(60px);
      opacity: 0;
      transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1),
                  opacity 0.3s ease;
    }

    .hero-card.splitting .visual-side {
      transform: translateY(-60px);
      opacity: 0;
      transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1),
                  opacity 0.3s ease;
    }

    /* 移动端合并动效 — 淡入 */
    .hero-card.merging .glass-content {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
      border-radius: 0 0 30px 30px;
      box-shadow: none;
      border: none;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.3s ease;
    }

    .hero-card.merging .visual-side {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
      border-radius: 30px 30px 0 0;
      box-shadow: none;
